#!/usr/bin/env bash
# frozen_string_literal: true
#
# Read-only local verification aligned with the RSpec CI workflow.
#
# Usage:
#   bin/verify          # Fast profile: lint + non-system specs + docs
#   bin/verify fast     # Same as the default profile
#   bin/verify full     # Fast profile + system specs + security audits
#   bin/verify lint     # Linting only
#   bin/verify docs     # Feature and architecture documentation audits
#   bin/verify combat   # Lint + arena/formula specs
#

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo_step() {
  echo -e "\n${YELLOW}▶ $1${NC}"
}

echo_info() {
  echo -e "${BLUE}ℹ $1${NC}"
}

echo_success() {
  echo -e "${GREEN}✓ $1${NC}"
}

echo_error() {
  echo -e "${RED}✗ $1${NC}"
}

run_lint() {
  echo_step "Running RuboCop (read-only)..."
  if bin/rubocop --format simple; then
    echo_success "RuboCop passed"
  else
    echo_error "RuboCop failed"
    exit 1
  fi
}

run_non_system_tests() {
  echo_step "Running non-system RSpec suite..."
  if bundle exec rspec --exclude-pattern "spec/system/**/*_spec.rb" --format progress; then
    echo_success "Non-system specs passed"
  else
    echo_error "Non-system specs failed"
    exit 1
  fi
}

run_system_tests() {
  echo_step "Running system specs..."
  if bundle exec rspec spec/system --format progress; then
    echo_success "System specs passed"
  else
    echo_error "System specs failed"
    exit 1
  fi
}

run_combat_tests() {
  echo_step "Running arena and game-formula specs..."
  if bundle exec rspec spec/services/arena spec/lib/game --format progress; then
    echo_success "Arena and game-formula specs passed"
  else
    echo_error "Arena or game-formula specs failed"
    exit 1
  fi
}

run_security() {
  echo_step "Running Brakeman..."
  bundle exec brakeman --quiet --no-pager

  echo_step "Running Bundler Audit..."
  bin/bundler-audit check --update

  echo_step "Running Importmap audit..."
  bin/importmap audit

  echo_success "Security audits passed"
}

run_feature_docs() {
  echo_step "Auditing feature documentation..."
  bin/feature-doc-audit
  echo_success "Feature documentation passed"

  echo_step "Auditing documentation architecture..."
  bin/documentation-architecture-audit
  echo_success "Documentation architecture passed"
}

print_success() {
  echo -e "\n${GREEN}═══════════════════════════════════════${NC}"
  echo -e "${GREEN}  ✓ Verification completed successfully  ${NC}"
  echo -e "${GREEN}═══════════════════════════════════════${NC}"
}

case "${1:-fast}" in
  lint)
    run_lint
    ;;
  docs)
    run_feature_docs
    ;;
  quick|fast)
    run_lint
    run_non_system_tests
    run_feature_docs
    print_success
    ;;
  combat)
    run_lint
    run_combat_tests
    run_feature_docs
    print_success
    ;;
  full)
    run_lint
    run_non_system_tests
    run_system_tests
    run_security
    run_feature_docs
    print_success
    ;;
  *)
    echo_error "Unknown profile: $1"
    echo_info "Use: fast, full, lint, docs, or combat"
    exit 2
    ;;
esac
