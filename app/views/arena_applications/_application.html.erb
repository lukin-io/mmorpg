<% character = local_assigns[:character] || current_character %>
<% member = application.member?(character) %>
<div class="nl-arena-application-row <%= 'nl-arena-row--own' if member %> <%= 'nl-arena-row--npc' if application.npc_application? %>" data-application-id="<%= application.id %>">
  <%= form_with url: accept_arena_room_arena_application_path(application.arena_room, application), method: :post, class: "nl-arena-accept-form", data: {turbo_frame: "_top"} do |form| %>
    <div class="nl-arena-application-line">
      <span class="nl-arena-rule-icons">
        <%= image_tag "arena/rule.png", width: 16, height: 16, alt: fight_kind_label(application.fight_kind), title: fight_kind_label(application.fight_kind) %>
        <span title="Timeout: <%= application.timeout_seconds / 60 %> min"><%= image_tag "arena/timeout.png", width: 16, height: 16, alt: "Timeout" %><span><%= application.timeout_seconds / 60 %></span></span>
        <%= image_tag "arena/trauma.png", width: 16, height: 16, alt: "Trauma #{application.trauma_percent}%", title: "Trauma #{application.trauma_percent}%" %>
      </span>
      <time><%= application.created_at.strftime("%H:%M:%S") %></time>
      <% if application.team_battle? %>
        <span>[ <%= application.team_count %> (<%= application.side_level_range("a").begin %>–<%= application.side_level_range("a").end %>) vs <%= application.enemy_count %> (<%= application.side_level_range("b").begin %>–<%= application.side_level_range("b").end %>) ]</span>
        <% %w[a b].each_with_index do |team, index| %>
          <% rejection = application.group_rejection_reason(character, team:) %>
          <span class="nl-arena-application-side" title="<%= rejection %>">
            <%= form.radio_button :team, team, id: "application_#{application.id}_#{team}", disabled: rejection.present?, required: true, aria: {label: "Join side #{team.upcase}"} %>
            <label for="application_<%= application.id %>_<%= team %>">
              <% members = application.members_for(team) %>
              <% if members.empty? %><b>no opponents</b><% end %>
              <% members.each do |entry| %>
                <b><%= entry.character.name %></b>[<%= entry.character.level %>]
              <% end %>
            </label>
          </span>
          <% if index.zero? %><span>versus</span><% end %>
        <% end %>
        <span data-arena-target="deadline" data-expires-at="<%= application.expires_at.iso8601 %>">Starts in <%= application.time_until_expiration %>s</span>
      <% else %>
        <span><b><%= application.applicant_name %></b>[<%= application.applicant_level %>]</span>
        <span>versus</span>
        <span title="<%= application.rejection_reason_for(character) %>"><%= form.radio_button :team, "b", id: "application_#{application.id}_b", checked: true, disabled: !application.acceptable_by?(character), aria: {label: "Opponent side"} %> <b>no opponents</b></span>
        <span class="nl-arena-muted"><%= arena_application_open_side_level_gate(application) %></span>
      <% end %>
    </div>
    <% unless member %>
      <%= form.submit "Accept", disabled: !application.acceptable_by?(character), class: "nl-arena-small-button" %>
      <% unless application.acceptable_by?(character) %><span class="nl-arena-muted">cannot accept</span><% end %>
    <% end %>
  <% end %>
  <% if member %>
    <%= button_to(application.applicant_id == character.id ? "Cancel Application" : "Leave Group", arena_room_arena_application_path(application.arena_room, application), method: :delete, class: "nl-arena-small-button", form: {data: {turbo_frame: "_top"}}) %>
  <% end %>
</div>
