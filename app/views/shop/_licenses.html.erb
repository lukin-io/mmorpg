<% if items.any? %>
  <div class="nl-shop-licenses">
    <% items.each do |template| %>
      <% offer = @shop_buy_offers[template.id] %>
      <% block_reason = shop_buy_block_reason(template) %>
      <% unavailable_reason = block_reason || (t("game.shop.refresh_buy") unless offer) %>
      <% affordable = unavailable_reason.blank? %>
      <% reason_id = dom_id(template, :shop_license_unavailable) if unavailable_reason %>
      <% quantity_id = dom_id(template, :shop_license_quantity) %>
      <% duration_days = template.enhancement_rules.fetch("license").fetch("duration_days") %>
      <article class="nl-shop-license"
               data-shop-license="<%= template.id %>"
               data-shop-license-affordable="<%= affordable ? "1" : "0" %>"
               aria-label="<%= template.display_name %>">
        <h2><%= template.display_name %></h2>
        <p class="nl-shop-license__description">
          <%= template.description %>
          <%= t("game.shop.license_valid_for", days: duration_days) %>
        </p>
        <div class="nl-shop-license__facts">
          <div><%= t("game.common.durability") %>: <b><%= template.durability_max %>/<%= template.durability_max %></b></div>
          <div><%= t("game.common.mass") %>: <b><%= number_with_precision(template.weight, precision: 2) %></b></div>
        </div>
        <% if artwork = item_artwork_path(template) %>
          <%= image_tag artwork, width: 60, height: 60, alt: "", class: "nl-shop-license__artwork" %>
        <% end %>
        <div class="nl-shop-license__cost"><b><%= t("game.shop.cost") %>: <%= number_with_precision(template.base_price, precision: 2) %> NV</b></div>
        <div class="nl-shop-license__stock"><%= t("game.shop.stock") %>: <b><%= shop_stock_label(template) %></b></div>
        <% if unavailable_reason %>
          <div class="nl-shop-action-form nl-shop-license__purchase">
            <label for="<%= quantity_id %>"><%= t("game.common.quantity") %>:</label>
            <%= text_field_tag :quantity, 1, size: 2, inputmode: "numeric", id: quantity_id,
                class: "nl-shop-license__quantity", disabled: true,
                title: unavailable_reason, aria: {describedby: reason_id} %>
            <button type="button" class="nl-shop-license__buy" disabled
                    title="<%= unavailable_reason %>" aria-describedby="<%= reason_id %>"><%= t("game.common.buy") %></button>
          </div>
          <span id="<%= reason_id %>" class="nl-shop-unavailable" data-shop-license-block="1">
            <%= unavailable_reason %>
            <%= shop_block_recovery_link(block_reason) %>
          </span>
        <% else %>
          <%= form_with url: buy_shop_path, method: :post, class: "nl-shop-action-form nl-shop-license__purchase", data: {turbo_confirm: t("game.shop.buy_confirm", name: template.display_name)} do |f| %>
            <%= f.hidden_field :mode, value: "licenses" %>
            <%= f.hidden_field :item_template_id, value: template.id %>
            <%= f.hidden_field :action_key, value: offer.action_key %>
            <%= f.label :quantity, "#{t("game.common.quantity")}:", for: quantity_id %>
            <%= f.text_field :quantity, value: 1, size: 2, inputmode: "numeric", id: quantity_id, class: "nl-shop-license__quantity" %>
            <%= f.submit t("game.common.buy"), class: "nl-shop-license__buy" %>
          <% end %>
        <% end %>
      </article>
    <% end %>
  </div>
<% else %>
  <p class="nl-empty-note nl-shop-empty" data-shop-licenses-empty="1">
    <%= t("game.shop.empty_section") %>
    ·
    <%= link_to t("game.shop.modes.buy"), shop_path(mode: "buy"), class: "nl-sheet-link", data: {shop_licenses_recovery: "buy"} %>
  </p>
<% end %>
