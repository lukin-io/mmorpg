<% if items.any? %>
  <table class="nl-shop-table">
    <tbody>
      <% items.each do |item| %>
        <% block_reason = shop_sell_block_reason(item) %>
        <% offer = @shop_sell_offers[item.id] %>
        <tr>
          <td class="nl-shop-icon-cell">
            <% if artwork = item_artwork_path(item.item_template) %>
              <%= image_tag artwork, **item_artwork_dimensions(item.item_template), alt: "", class: "nl-shop-item-icon" %>
            <% else %>
              <span class="nl-shop-category__icon nl-shop-item-icon" style="<%= shop_category_icon_style(Game::Shop::Catalog.category_for(item.item_template)) %>" aria-hidden="true"></span>
            <% end %>
            <% if item.durable? %>
              <meter class="nl-shop-durability" value="<%= item.current_durability %>" max="<%= item.max_durability %>" aria-label="Durability <%= item.item_template.name %>"></meter>
            <% end %>
          </td>
          <td class="nl-shop-row-content">
            <div class="nl-shop-item-heading">
              <strong><%= item.item_template.name %></strong>
              <span>(quantity: <%= shop_stock_label(item.item_template) %>)</span>
              <span>Quantity: <%= item.quantity %></span>
            </div>
            <div class="nl-shop-item-trade">
              <% if block_reason || !offer %>
                <span class="nl-shop-unavailable"><%= block_reason || "Refresh to sell" %></span>
              <% else %>
                <%= form_with url: sell_shop_path, method: :post, class: "nl-shop-action-form", data: {turbo_confirm: "Sell #{item.item_template.name}?"} do |f| %>
                  <%= f.hidden_field :mode, value: "sell" %>
                  <%= f.hidden_field :category, value: @category %>
                  <% shop_filter_context.each do |key, value| %>
                    <%= f.hidden_field key, value: value %>
                  <% end %>
                  <%= f.hidden_field :item_id, value: item.id %>
                  <%= f.hidden_field :action_key, value: offer.action_key %>
                  <%= f.submit "Sell for #{number_with_delimiter(shop_sale_price(item))} NV", class: "invbut" %>
                <% end %>
              <% end %>
            </div>
            <div class="nl-shop-item-details">
              <section>
                <h2>properties</h2>
                <dl class="nl-shop-properties">
                  <% shop_item_properties(item.item_template, item:).each do |label, value| %>
                    <div><dt><%= label %>:</dt> <dd><b><%= value %></b></dd></div>
                  <% end %>
                </dl>
              </section>
              <section>
                <h2>requirements</h2>
                <ul class="nl-shop-requirements">
                  <% shop_item_requirements(item.item_template).each do |label, value, met| %>
                    <li>
                      <span><%= label %>:</span> <b class="<%= 'nl-shop-requirement--missing' unless met %>"><%= value %></b>
                    </li>
                  <% end %>
                </ul>
              </section>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="nl-empty-note nl-shop-empty">There are no sellable items in inventory.</p>
<% end %>
