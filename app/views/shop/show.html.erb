<div class="nl-shop-page">
  <h1 class="sr-only">Shop</h1>
  <%= render "shared/building_entrance", asset: "shop/interior.png" %>

  <div class="nl-shop-frame">
    <nav class="nl-shop-tabs" aria-label="Shop mode">
      <% shop_mode_options.each do |key, label| %>
        <%= link_to label,
                    shop_path(mode: key, category: @category, **shop_filter_context),
                    class: ["nl-shop-tab", ("nl-shop-tab--active" if @mode == key)],
                    aria: {current: ("page" if @mode == key)},
                    data: {turbo_action: "advance"} %>
      <% end %>
    </nav>

    <% unless @mode == "licenses" %>
      <div class="nl-shop-filter-viewport">
        <nav class="nl-shop-categories" aria-label="Item category">
          <% shop_category_options.each do |key, label| %>
            <%= link_to shop_path(mode: @mode, category: key, **shop_filter_context),
                        class: ["nl-shop-category", ("nl-shop-category--active" if @category == key)],
                        title: label,
                        data: {turbo_action: "advance"},
                        aria: {label: label, current: (@category == key ? "page" : nil)} do %>
              <span class="nl-shop-category__icon" style="<%= shop_category_icon_style(key) %>" aria-hidden="true"></span>
            <% end %>
          <% end %>
        </nav>

        <%= form_with url: shop_path, method: :get, class: "nl-shop-filters", local: true, data: {turbo_action: "advance"} do |f| %>
          <%= f.hidden_field :mode, value: @mode %>
          <%= f.hidden_field :category, value: @category %>
          <span class="nl-shop-filter-label">Level:</span>
          <%= f.text_field :min_level, value: @catalog.filters[:min_level], size: 3, inputmode: "numeric", class: "nl-shop-mini-input", aria: {label: "Minimum level"} %>
          <span aria-hidden="true">-</span>
          <%= f.text_field :max_level, value: @catalog.filters[:max_level], size: 3, inputmode: "numeric", class: "nl-shop-mini-input", aria: {label: "Maximum level"} %>
          <span class="nl-shop-filter-label nl-shop-filter-label--price">Price:</span>
          <%= f.text_field :min_price, value: @catalog.filters[:min_price], size: 20, inputmode: "numeric", class: "nl-shop-price-input", aria: {label: "Minimum price"} %>
          <span aria-hidden="true">-</span>
          <%= f.text_field :max_price, value: @catalog.filters[:max_price], size: 20, inputmode: "numeric", class: "nl-shop-price-input", aria: {label: "Maximum price"} %>
          <span>NV</span>
          <%= f.submit "Apply", class: "invbut" %>
        <% end %>
      </div>
    <% end %>

    <div class="nl-shop-table-viewport">
      <% unless @mode == "licenses" %>
        <div class="nl-shop-status-row">
          <div>You carry <b><%= number_with_precision(@wallet.nv_balance, precision: 2) %> NV</b> and items weighing: <b><%= number_with_precision(@inventory.current_weight, precision: 2) %></b>. Maximum weight: <b><%= shop_max_weight %></b></div>
          <% if @shop_account %>
            <div>Shop funds: <b><%= number_with_precision(@shop_account.nv_balance, precision: 2) %> NV</b></div>
          <% end %>
        </div>
      <% end %>
      <% if @mode == "licenses" %>
        <%= render "shop/licenses", items: @shop_items %>
      <% elsif @mode == "novice" && current_character.level >= 10 %>
        <p class="nl-empty-note nl-shop-empty">This section is available only to players below level 10.</p>
      <% elsif @mode == "sell" %>
        <%= render "shop/sell_table", items: @sell_items %>
      <% else %>
        <%= render "shop/buy_table", items: @shop_items %>
      <% end %>
    </div>
    <% if @mode == "licenses" && Game::Shop::MerchantQualification.new(character: current_character).status.in?(%w[accepted paid]) %>
      <div class="nl-shop-qualification">
        <%= render "shop/merchant_qualification", location: :shop %>
      </div>
    <% end %>
  </div>
</div>
