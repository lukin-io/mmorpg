<% qualification = Game::Shop::MerchantQualification.new(character: current_character) %>
<% if qualification.visible_at?(location) %>
  <section class="nl-panel" aria-label="<%= t("game.shop.merchant_title") %>" data-merchant-desk="1">
    <h2><%= t("game.shop.merchant_title") %></h2>
    <% case qualification.status %>
    <% when "completed" %>
      <p class="nl-empty-note" data-merchant-status="completed">
        <%= t("game.shop.merchant_done") %>
        ·
        <%= link_to t("game.shop.modes.licenses"), shop_path(mode: "licenses"), class: "nl-sheet-link", data: {merchant_recovery: "licenses"} %>
      </p>
    <% when "not_started" %>
      <% if location == :market %>
        <p class="nl-empty-note" data-merchant-status="not_started"><%= t("game.shop.merchant_accept") %></p>
        <%= button_to t("game.shop.merchant_accept_btn"), accept_merchant_qualification_path, class: "lbut" %>
      <% else %>
        <p class="nl-empty-note" data-merchant-status="market-first">
          <%= t("game.shop.merchant_market_first") %>
          <% if Game::World::CityBuildingCatalog.accessible?(character: current_character, building_key: "market") %>
            ·
            <%= link_to t("game.buildings.market_short"), city_building_path("market"), class: "nl-sheet-link", data: {merchant_recovery: "market"} %>
          <% else %>
            ·
            <%= link_to t("arena.nav.city"), world_path, class: "nl-sheet-link", data: {merchant_recovery: "world"} %>
          <% end %>
        </p>
      <% end %>
    <% when "accepted" %>
      <% if location == :shop %>
        <p class="nl-empty-note" data-merchant-status="collect-shop-pay"><%= t("game.shop.merchant_collect_market") %></p>
        <%= button_to t("game.shop.merchant_pay_btn"), pay_merchant_qualification_path, class: "lbut" %>
      <% else %>
        <p class="nl-empty-note" data-merchant-status="collect-shop">
          <%= t("game.shop.merchant_collect_shop") %>
          ·
          <%= link_to t("game.shop.title"), shop_path(mode: "licenses"), class: "nl-sheet-link", data: {merchant_recovery: "shop"} %>
        </p>
      <% end %>
    <% when "paid" %>
      <% if location == :market %>
        <p class="nl-empty-note" data-merchant-status="receipt-ready"><%= t("game.shop.merchant_receipt_ready") %></p>
        <%= button_to t("game.shop.merchant_complete_btn"), complete_merchant_qualification_path, class: "lbut" %>
      <% else %>
        <p class="nl-empty-note" data-merchant-status="receipt-market">
          <%= t("game.shop.merchant_receipt_done") %>
          <% if Game::World::CityBuildingCatalog.accessible?(character: current_character, building_key: "market") %>
            ·
            <%= link_to t("game.buildings.market_short"), city_building_path("market"), class: "nl-sheet-link", data: {merchant_recovery: "market"} %>
          <% else %>
            ·
            <%= link_to t("arena.nav.city"), world_path, class: "nl-sheet-link", data: {merchant_recovery: "world"} %>
          <% end %>
        </p>
      <% end %>
    <% else %>
      <p class="nl-empty-note" data-merchant-status="unavailable">
        <%= t("game.shop.merchant_unavailable") %>
        ·
        <%= link_to t("arena.nav.city"), world_path, class: "nl-sheet-link", data: {merchant_recovery: "world"} %>
      </p>
    <% end %>
  </section>
<% end %>
