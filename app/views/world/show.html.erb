<%#
  World View
  Uses game.html.erb layout with top bar, main content, and bottom panel
%>
<% content_for :title, @zone.name %>

<div class="nl-world-container nl-world-container--map">
  <%= render "shared/premium_auto_rail" %>
  <%# City-defense CTA belongs on the city surface only — outdoor FOMO used to
      look like a false ambush next to wilderness cells. %>
  <% fair = WorldLiveEvent.active.of_kind("season_fair").order(starts_at: :desc).first %>
  <% if fair %>
    <p class="nl-quests-board__meta" data-season-fair="1">
      <strong class="game-event-attention"><%= fair.title %></strong>
      — <%= fair.body %>
      · <%= link_to t("game.buildings.market_short"), city_building_path("market"), class: "nl-sheet-link", data: {turbo_frame: "_top"} %>
      · <%= link_to t("game.season.nav"), season_path, class: "nl-sheet-link", data: {turbo_frame: "_top"} %>
    </p>
  <% end %>
  <turbo-frame id="game-map">
    <%= render "world/map",
               position: @position,
               nearby_tiles: @nearby_tiles,
               zone: @zone,
               tile_data: @tile_data,
               movement_destinations: @movement_destinations,
               active_movement: @active_movement,
               movement_remaining_seconds: @movement_remaining_seconds %>
  </turbo-frame>

  <turbo-frame id="location-info">
    <%= render "world/location_info", position: @position, location_label: @presence_location_label %>
  </turbo-frame>

  <div id="world-action-result">
    <% if @world_action_result.present? %>
      <%= render "world/action_result", message: @world_action_result %>
    <% end %>
  </div>
</div>
