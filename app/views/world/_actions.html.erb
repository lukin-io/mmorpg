<%
  tile_building_action = available_actions.find { |action| action[:type] == :tile_building }
  tile_local_actions = available_actions.select { |action| action[:type] == :tile_local_action }
  local_actions_present = tile_building_action || tile_local_actions.any?
%>

<% if @movement_state&.locked_reason == :fatigued %>
  <span class="nl-world-action-unavailable" title="Fatigue is 86% or higher. Move, Look, and Enter are unavailable until it recovers.">Actions unavailable</span>
  <span class="nl-visually-hidden">Move, Look, and Enter are unavailable until fatigue recovers.</span>
<% end %>

<% if local_actions_present %>
  <div class="actions-panel nl-world-action-strip" aria-label="Current cell actions">
    <% if tile_building_action && tile_building_action[:building] %>
      <% building = tile_building_action[:building] %>
      <% offer = tile_building_action[:offer] %>

      <% if building[:can_enter] && offer %>
        <%= form_with url: enter_building_world_path,
                      method: :post,
                      class: "nl-world-action-form",
                      data: {turbo: true} do |f| %>
          <%= f.hidden_field :building_id, value: building[:id] %>
          <%= f.hidden_field :action_key, value: offer.action_key %>
          <%= f.submit "Enter", class: "nl-nav-link nl-world-action-button", title: building[:name] %>
          <span class="nl-visually-hidden"><%= building[:name] %> <%= building[:destination] %> <%= building[:description] %></span>
        <% end %>
      <% else %>
        <button type="button"
                class="nl-nav-link nl-world-action-button"
                title="<%= building[:blocked_reason] %>"
                disabled>Enter</button>
        <span class="building-blocked nl-visually-hidden"><%= building[:name] %> <%= building[:blocked_reason] %></span>
      <% end %>
    <% end %>

    <% tile_local_actions.each do |action| %>
      <% local_action = action[:local_action] %>
      <% offer = action[:offer] %>
      <%= form_with url: perform_local_action_world_path,
                    method: :post,
                    class: "nl-world-action-form",
                    data: {turbo: true} do |f| %>
        <%= f.hidden_field :tile_id, value: local_action[:tile_id] %>
        <%= f.hidden_field :local_action_type, value: local_action[:local_action_type] %>
        <%= f.hidden_field :action_key, value: offer.action_key %>
        <%= f.submit local_action[:label],
                     class: "nl-nav-link nl-world-action-button",
                     title: local_action[:description] %>
        <% if local_action[:description].present? %>
          <span class="nl-visually-hidden"><%= local_action[:description] %></span>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% end %>
