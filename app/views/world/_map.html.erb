<%
  map_buffer = local_assigns.fetch(:map_buffer, @map_buffer)
  grid_width = map_buffer ? (Game::World::MapBuffer::X_RADIUS * 2 + 1) : (nearby_tiles.first&.size || 1)
  grid_height = map_buffer ? (Game::World::MapBuffer::Y_RADIUS * 2 + 1) : nearby_tiles.size
  tile_size = 100
  visible_columns = [grid_width - 2, 1].max
  visible_rows = [grid_height - 2, 1].max
  map_offset_x = grid_width > visible_columns ? -tile_size : 0
  map_offset_y = grid_height > visible_rows ? -tile_size : 0
  cursor_left = (visible_columns / 2) * tile_size
  cursor_top = (visible_rows / 2) * tile_size
  movement_destinations = local_assigns.fetch(:movement_destinations, @movement_destinations || []) || []
  active_movement = local_assigns.fetch(:active_movement, @active_movement)
  active_world_action = local_assigns.fetch(:active_world_action, @active_world_action)
  movement_remaining_seconds = local_assigns.fetch(
    :movement_remaining_seconds,
    @movement_remaining_seconds || active_movement&.remaining_seconds || 0
  )
  destinations_by_coord = movement_destinations.index_by { |destination| [destination.target_x, destination.target_y] }
  movement_active = active_movement.present?
  world_action_active = active_world_action.present?
  timer_active = movement_active || world_action_active
  timer_remaining_seconds = if world_action_active
    active_world_action.local_action_remaining_seconds
  else
    movement_remaining_seconds
  end
  movement_delta_x = if movement_active && active_movement.respond_to?(:target_x) && active_movement.respond_to?(:from_x)
    active_movement.target_x.to_i - active_movement.from_x.to_i
  else
    0
  end
  movement_delta_y = if movement_active && active_movement.respond_to?(:target_y) && active_movement.respond_to?(:from_y)
    active_movement.target_y.to_i - active_movement.from_y.to_i
  else
    0
  end
  movement_total_seconds = if movement_active && active_movement.respond_to?(:travel_seconds)
    active_movement.travel_seconds.to_i
  else
    movement_remaining_seconds.to_i
  end
%>

<div class="nl-map-container"
     data-controller="nl-world-map"
     data-action="turbo:before-stream-render@document->nl-world-map#renderMapStream turbo:frame-missing@document->nl-world-map#recoverFrameNavigation"
     data-map-refresh="<%= request.format.turbo_stream? %>"
     data-map-buffer="<%= map_buffer&.token %>"
     data-map-base="<%= map_buffer&.base_token %>"
     data-map-revision="<%= map_buffer&.revision %>"
     data-map-zone="<%= zone.id %>"
     data-map-min-x="<%= position.x - grid_width / 2 %>"
     data-map-min-y="<%= position.y - grid_height / 2 %>"
     data-map-columns="<%= grid_width %>"
     data-map-rows="<%= grid_height %>"
     data-nl-world-map-player-x-value="<%= position.x %>"
     data-nl-world-map-player-y-value="<%= position.y %>"
     data-nl-world-map-move-url-value="<%= move_world_path %>"
     data-nl-world-map-zone-width-value="<%= zone.width %>"
     data-nl-world-map-zone-height-value="<%= zone.height %>"
     data-nl-world-map-tile-size-value="<%= tile_size %>"
     data-nl-world-map-max-visible-columns-value="<%= visible_columns %>"
     data-nl-world-map-max-visible-rows-value="<%= visible_rows %>"
     data-nl-world-map-move-cooldown-value="<%= @movement_cooldown || 3 %>"
     data-nl-world-map-zone-name-value="<%= zone.name %>"
     data-nl-world-map-map-offset-x-value="<%= map_offset_x %>"
     data-nl-world-map-map-offset-y-value="<%= map_offset_y %>"
     data-nl-world-map-movement-active-value="<%= movement_active %>"
     data-nl-world-map-movement-remaining-seconds-value="<%= movement_remaining_seconds %>"
     data-nl-world-map-movement-total-seconds-value="<%= movement_total_seconds %>"
     data-nl-world-map-movement-delta-x-value="<%= movement_delta_x %>"
     data-nl-world-map-movement-delta-y-value="<%= movement_delta_y %>"
     data-nl-world-map-movement-ends-at-value="<%= active_movement&.ends_at&.iso8601(3) %>"
     data-nl-world-map-work-active-value="<%= world_action_active %>"
     data-nl-world-map-work-ends-at-value="<%= active_world_action&.local_action_ends_at&.iso8601(3) %>"
     data-nl-world-map-work-remaining-seconds-value="<%= world_action_active ? timer_remaining_seconds : 0 %>"
     data-nl-world-map-server-now-value="<%= Time.current.iso8601(3) %>"
     data-nl-world-map-complete-url-value="<%= world_path %>">

  <div class="nl-map-viewport"
       id="world_cont"
       data-nl-world-map-target="viewport"
       style="--nl-map-visible-columns: <%= visible_columns %>; --nl-map-visible-rows: <%= visible_rows %>;">
    <div class="nl-map-world"
         id="world_map"
         data-nl-world-map-target="mapContainer"
         style="transform: translate(<%= map_offset_x %>px, <%= map_offset_y %>px);">
      <table border="0" cellpadding="0" cellspacing="0">
        <tbody>
          <% nearby_tiles.each_with_index do |row, row_index| %>
            <tr data-map-y="<%= position.y - grid_height / 2 + row_index %>">
              <% row.each do |tile| %>
                <%= render "world/map_cell", tile:, position:, zone:, destinations_by_coord:, timer_active:, tile_size: %>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="nl-map-overlay" id="world_cont2" data-nl-world-map-target="overlay">
      <div class="nl-cursor"
           id="cursor"
           data-nl-world-map-target="cursor"
           style="left: <%= cursor_left %>px; top: <%= cursor_top %>px;">
        <div class="nl-cursor-img <%= movement_active ? 'nl-cursor-img--moving' : 'nl-cursor-img--idle' %>"
             data-nl-world-map-target="cursorImg"></div>
      </div>

      <div class="nl-timer-text"
           id="timerdiv"
           data-nl-world-map-target="timerDiv"
           style="left: <%= cursor_left %>px; top: <%= cursor_top - tile_size %>px; display: <%= timer_active ? 'block' : 'none' %>;">
        <span class="nl-timer-seconds"
              id="tdsec"
              data-nl-world-map-target="timerSeconds"><%= timer_active ? timer_remaining_seconds : "" %></span>
      </div>
    </div>
  </div>

  <div class="nl-map-info nl-visually-hidden" aria-live="polite">
    <span class="nl-location-name"><%= zone.name %></span>
    <span class="nl-location-coords">[<%= position.x %>, <%= position.y %>]</span>
  </div>

  <%= form_with url: move_world_path,
                method: :post,
                id: "movement-form",
                class: "nl-move-form",
                data: {
                  turbo: true,
                  nl_world_map_target: "moveForm",
                  action: "turbo:submit-end->nl-world-map#submissionFinished turbo:fetch-request-error->nl-world-map#submissionFailed"
                },
                style: "display: none;" do |f| %>
    <%= f.hidden_field :map_buffer, value: map_buffer&.token %>
    <%= f.hidden_field :direction, id: "movement-direction", value: "" %>
    <%= f.hidden_field :target_x, id: "movement-target-x", value: "" %>
    <%= f.hidden_field :target_y, id: "movement-target-y", value: "" %>
    <%= f.hidden_field :action_key, id: "movement-action-key", value: "" %>
  <% end %>

  <%= form_with url: world_path, method: :get,
      data: {turbo_stream: true, turbo_frame: "game-map", nl_world_map_target: "refreshForm",
             action: "turbo:submit-end->nl-world-map#refreshFinished turbo:fetch-request-error->nl-world-map#refreshFailed"},
      hidden: true do |f| %>
    <%= f.hidden_field :map_buffer, value: map_buffer&.token %>
  <% end %>

  <% if map_buffer&.base_token %>
    <template data-map-controls>
      <% ([{x: position.x, y: position.y, destination: nil}] + movement_destinations.map { |destination| {x: destination.target_x, y: destination.target_y, destination:} }).each do |control| %>
        <div data-x="<%= control[:x] %>" data-y="<%= control[:y] %>">
          <%= render "world/map_control", destination: control[:destination], is_player: control[:destination].nil?, timer_active: %>
        </div>
      <% end %>
    </template>
  <% end %>
</div>
