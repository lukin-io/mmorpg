<%
  current_zone = local_assigns[:zone] || @zone
  hotspots = local_assigns[:hotspots] || @hotspots || []
  offers_by_hotspot_id = local_assigns[:offers_by_hotspot_id] || @city_action_offers_by_hotspot_id || {}
  node_key = current_zone.metadata.to_h["city_node_key"]
  presentation = current_zone.city_presentation.presence || Game::World::CityCatalog.presentation(node_key) || {
    "image_offset" => [0, 0],
    "focus" => [Game::World::CityCatalog::SCENE_WIDTH / 2, Game::World::CityCatalog::SCENE_HEIGHT / 2],
    "hotspots" => {},
    "landmarks" => {}
  }
  image_asset = presentation["image_asset"].presence
  image_width, image_height = presentation.fetch("image_size", [Game::World::CityCatalog::SCENE_WIDTH, Game::World::CityCatalog::SCENE_HEIGHT])
  image_x, image_y = presentation.fetch("image_offset", [0, 0])
  tooltip_actions = "pointerenter->nl-city-map#showTooltip pointermove->nl-city-map#moveTooltip pointerleave->nl-city-map#hideTooltip focus->nl-city-map#showTooltip blur->nl-city-map#hideTooltip" if image_asset
%>

<div class="city-view-container city-actions">
  <% if image_asset %>
    <h1 class="nl-visually-hidden city-name"><%= current_zone.display_name %></h1>
  <% end %>
  <%= render "shared/premium_auto_rail" %>
  <% if WorldLiveEvent.active.of_kind("city_attack").exists? %>
    <p class="nl-world-city-defense" data-city-defense="1">
      <strong class="game-event-attention"><%= t("game.world.city_defense_hint") %></strong>
      <%= button_to t("game.world.city_defense_cta"),
            world_city_defense_path,
            method: :post,
            class: "lbut",
            form: {data: {turbo: false}},
            title: t("game.world.city_defense_hint") %>
    </p>
  <% end %>
  <% if node_key.to_s == "main" %>
    <p class="nl-starter-tip" role="note"><%= t("game.world.starter_tip") %></p>
  <% elsif current_zone&.city? %>
    <p class="nl-starter-tip" role="note"><%= t("game.world.district_help_tip") %></p>
  <% end %>
  <% if params[:shop_denied].to_s == "1" %>
    <p class="nl-quests-board__meta" data-shop-denied="1">
      <%= t("game.shop.denied_next") %>
      ·
      <%= link_to t("game.trade_hub.title"), trade_hub_path(tab: "supply"), class: "nl-sheet-link", data: {shop_recovery: "trade_hub"} %>
      ·
      <% if hotspots.any? { |hotspot| hotspot.action_params.to_h["feature"] == "shop" && hotspot.can_interact?(current_character) } %>
        <%= link_to t("game.shop.title"), shop_path, class: "nl-sheet-link", data: {shop_recovery: "shop"} %>
      <% elsif hotspots.any? { |hotspot| hotspot.key.to_s == "go_main" } %>
        <span data-shop-recovery="main"><%= t("game.shop.denied_use_main") %></span>
      <% else %>
        <%= link_to t("arena.nav.city"), world_path, class: "nl-sheet-link", data: {shop_recovery: "world"} %>
      <% end %>
    </p>
  <% end %>
  <% if params[:building_denied].to_s == "1" %>
    <p class="nl-quests-board__meta" data-building-denied="1">
      <%= t("game.buildings.denied_next") %>
      ·
      <% if hotspots.any? { |hotspot| hotspot.key.to_s == "go_main" } %>
        <span data-building-recovery="main"><%= t("game.buildings.denied_use_main") %></span>
      <% else %>
        <%= link_to t("arena.nav.city"), world_path, class: "nl-sheet-link", data: {building_recovery: "world"} %>
      <% end %>
    </p>
  <% end %>
  <% if params[:arena_gate_denied].to_s == "1" %>
    <p class="nl-quests-board__meta" data-arena-gate-denied="1">
      <%= t("game.world.arena_gate_denied_next") %>
      ·
      <%= link_to t("arena.nav.city"), world_path, class: "nl-sheet-link", data: {arena_recovery: "world"} %>
      ·
      <% if hotspots.any? { |hotspot| hotspot.key.to_s == "arena" } %>
        <span data-arena-recovery="square"><%= t("arena.nav.arena") %></span>
      <% else %>
        <%= link_to t("arena.nav.arena"), world_path, class: "nl-sheet-link", data: {arena_recovery: "square"} %>
      <% end %>
    </p>
  <% end %>
  <% if params[:assault_denied].to_s == "1" %>
    <p class="nl-quests-board__meta" data-assault-denied="1">
      <%= t("game.world.assault_denied_next") %>
      ·
      <%= link_to t("arena.nav.city"), world_path, class: "nl-sheet-link", data: {assault_recovery: "world"} %>
    </p>
  <% end %>
  <% if params[:obelisk_denied].to_s == "1" %>
    <p class="nl-quests-board__meta" data-obelisk-denied="1">
      <%= t("game.buildings.obelisk_denied_next") %>
      ·
      <%= link_to t("arena.nav.city"), world_path, class: "nl-sheet-link", data: {obelisk_recovery: "world"} %>
    </p>
  <% end %>
  <% if params[:hotspot_denied].to_s == "1" %>
    <p class="nl-quests-board__meta" data-hotspot-denied="1">
      <%= t("game.world.hotspot_denied_next") %>
      ·
      <%= link_to t("arena.nav.city"), world_path, class: "nl-sheet-link", data: {hotspot_recovery: "world"} %>
    </p>
  <% end %>
  <% if params[:action_denied].to_s == "1" %>
    <p class="nl-quests-board__meta" data-action-denied="1">
      <%= t("game.world.action_denied_next") %>
      ·
      <%= link_to t("arena.nav.city"), world_path, class: "nl-sheet-link", data: {action_recovery: "world"} %>
    </p>
  <% end %>
  <% if params[:merchant_denied].to_s == "1" %>
    <p class="nl-quests-board__meta" data-merchant-denied="1">
      <%= t("game.shop.merchant_denied_next") %>
      ·
      <%= link_to t("arena.nav.city"), world_path, class: "nl-sheet-link", data: {merchant_recovery: "world"} %>
    </p>
  <% end %>
  <% if params[:location_denied].to_s == "1" %>
    <p class="nl-quests-board__meta" data-location-denied="1">
      <%= t("game.locations.denied_next") %>
      ·
      <%= link_to t("arena.nav.city"), world_path, class: "nl-sheet-link", data: {location_recovery: "world"} %>
    </p>
  <% end %>
  <% if params[:character_denied].to_s == "1" %>
    <p class="nl-quests-board__meta" data-character-denied="1">
      <%= t("game.sheet.denied_next") %>
      ·
      <%= link_to t("arena.nav.character"), player_path(name: current_character.name), class: "nl-sheet-link", data: {character_recovery: "sheet"} %>
      ·
      <%= link_to t("arena.nav.city"), world_path, class: "nl-sheet-link", data: {character_recovery: "world"} %>
    </p>
  <% end %>
  <% if params[:player_denied].to_s == "1" %>
    <p class="nl-quests-board__meta" data-player-denied="1">
      <%= t("game.profile.missing_next") %>
      ·
      <%= link_to t("arena.nav.character"), player_path(name: current_character.name), class: "nl-sheet-link", data: {player_recovery: "sheet"} %>
      ·
      <%= link_to t("arena.nav.city"), world_path, class: "nl-sheet-link", data: {player_recovery: "world"} %>
    </p>
  <% end %>
  <% if params[:airship_denied].to_s == "1" %>
    <p class="nl-quests-board__meta" data-airship-denied="1">
      <%= t("game.airship.denied_next") %>
      ·
      <%= link_to t("arena.nav.city"), world_path, class: "nl-sheet-link", data: {airship_recovery: "world"} %>
    </p>
  <% end %>
  <% if params[:chat_denied].to_s == "1" %>
    <p class="nl-quests-board__meta" data-chat-denied="1">
      <%= t("game.chat.denied_next") %>
      ·
      <%= link_to t("arena.nav.city"), world_path, class: "nl-sheet-link", data: {chat_recovery: "world"} %>
    </p>
  <% end %>

  <div class="nl-city-viewport<%= ' nl-city-viewport--pending' unless image_asset %>"
       data-controller="<%= 'nl-scene-size nl-city-map' if image_asset %>"
       data-nl-city-map-target="viewport"
       data-action="nl-scene-size:resize->nl-city-map#hideTooltip">
    <div class="nl-city-image-frame">
    <div class="nl-city-scene<%= ' nl-city-scene--pending' unless image_asset %>"
         aria-label="<%= current_zone.display_name %> city map"
         <% if image_asset %>
         data-nl-scene-size-target="canvas"
         style="--nl-city-image-url: url(<%= asset_path(image_asset).to_json %>); --nl-city-image-width: <%= image_width %>px; --nl-city-image-height: <%= image_height %>px; --nl-city-image-x: <%= image_x %>px; --nl-city-image-y: <%= image_y %>px;"
         <% end %>>
      <% if image_asset %>
      <%= image_tag image_asset,
                    class: "nl-city-scene-image",
                    alt: "",
                    aria: {hidden: true},
                    style: "left: #{image_x}px; top: #{image_y}px;" %>
      <% else %>
        <h1 class="nl-city-pending-title city-name"><%= current_zone.display_name %></h1>
        <p class="nl-city-pending-notice"><%= t("game.world.quarter_pending") %></p>
      <% end %>

      <nav class="nl-city-hotspots" aria-label="<%= t("game.world.city_buildings") %>">
        <% hotspots.each_with_index do |hotspot, index| %>
          <% next if hotspot.hotspot_type == "district" %>
          <%= render "world/city_action", hotspot:, index:, node_key:, image_asset:, tooltip_actions:, offers_by_hotspot_id: %>
        <% end %>
      </nav>

      <% if image_asset %>
      <div class="nl-city-landmarks" aria-label="<%= t("game.world.city_landmarks") %>">
        <% presentation.fetch("landmarks", {}).each do |landmark_key, landmark| %>
          <% left, top, width, height = landmark.fetch("box") %>
          <span class="nl-city-hotspot nl-city-hotspot--landmark"
                style="left: <%= left %>px; top: <%= top %>px; width: <%= width %>px; height: <%= height %>px; --nl-city-hotspot-x: <%= left %>px; --nl-city-hotspot-y: <%= top %>px; <%= city_hotspot_polygon_style(landmark['polygon']) %>"
                data-landmark-key="<%= landmark_key %>"
                data-tooltip="<%= landmark.fetch('name') %>"
                data-action="<%= tooltip_actions %>"
                role="img"
                aria-label="<%= landmark.fetch('name') %>"
                tabindex="0">
            <span class="nl-visually-hidden"><%= landmark.fetch("name") %></span>
          </span>
        <% end %>
      </div>
      <% end %>

    </div>
    </div>
    <% if hotspots.any? { |hotspot| hotspot.hotspot_type == "district" } %>
    <nav class="nl-city-routes" aria-label="<%= t("game.world.city_routes") %>">
      <% hotspots.each_with_index do |hotspot, index| %>
        <% next unless hotspot.hotspot_type == "district" %>
        <%= render "world/city_action", hotspot:, index:, node_key:, image_asset:, tooltip_actions:, offers_by_hotspot_id: %>
      <% end %>
    </nav>
    <% end %>
    <% building_hotspots = hotspots.reject { |hotspot| hotspot.hotspot_type == "district" } %>
    <% if building_hotspots.any? %>
    <nav class="nl-city-building-controls" aria-label="<%= t("game.world.city_building_controls") %>" data-city-building-controls="1">
      <% building_hotspots.each_with_index do |hotspot, index| %>
        <%= render "world/city_action", hotspot:, index:, node_key:, image_asset:, tooltip_actions:, offers_by_hotspot_id:, named_layout: true %>
      <% end %>
    </nav>
    <% end %>
    <% if image_asset %>
    <div class="nl-city-tooltip"
         data-nl-city-map-target="tooltip"
         role="status"
         hidden></div>
    <% end %>
  </div>
</div>
