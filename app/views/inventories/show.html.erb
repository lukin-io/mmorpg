<% content_for :title, "Inventory" %>

<section class="inventory-page nl-inventory-page" data-controller="inventory">
  <div class="nl-source-character-grid nl-source-inventory-grid <%= 'nl-source-inventory-grid--family' unless inventory_equipment_family?(@category) %>">
    <% if inventory_equipment_family?(@category) %>
      <aside class="nl-source-character-left">
        <div id="equipment_panel">
          <%= render "shared/neverlands_character_sheet",
            character: current_character,
            equipment: @equipment,
            interactive: true,
            show_money: true,
            category: @category,
            subcategory: @subcategory,
            info_mode: @info_mode %>
        </div>

        <% if @equipment.values.compact.uniq.any? %>
          <div class="nl-source-equipment-actions">
            <%= button_to "Remove all gear",
              unequip_all_inventory_path(category: @category, subcategory: @subcategory, info: @info_mode),
              method: :post,
              class: "invbut",
              data: {turbo_confirm: "Remove all equipped items?"} %>
          </div>
        <% end %>

        <%= render "inventories/equipment_sets" %>
      </aside>
    <% end %>

    <main class="nl-source-inventory-main">
      <nav class="nl-source-inventory-icons nl-source-inventory-icons--utilities" aria-label="Inventory display controls">
        <%= link_to "Gear",
          inventory_path(category: @category, subcategory: @subcategory, info: @info_mode),
          class: "nl-source-inventory-icon nl-source-inventory-icon--text nl-source-inventory-icon--active",
          title: "Equipment" %>
        <%= link_to "Brief",
          inventory_path(category: @category, subcategory: @subcategory, info: "short"),
          class: "nl-source-inventory-icon nl-source-inventory-icon--text",
          title: "Short information" %>
        <%= link_to "Reset",
          inventory_path(info: @info_mode),
          class: "nl-source-inventory-icon nl-source-inventory-icon--text",
          title: "Reset filter" %>
      </nav>

      <nav class="nl-source-inventory-icons nl-source-inventory-icons--categories" aria-label="Inventory categories">
        <% inventory_category_options.reject { |key, _label| key == "things" }.each do |key, label| %>
          <% mark = inventory_category_mark(key) %>
          <% if @category == key %>
            <span class="nl-source-inventory-icon nl-source-inventory-icon--text nl-source-inventory-icon--active" title="<%= label %>" aria-current="page"><%= mark %></span>
          <% else %>
            <%= link_to mark,
              inventory_path(category: key, info: @info_mode),
              class: "nl-source-inventory-icon nl-source-inventory-icon--text",
              title: label,
              aria: {label: label} %>
          <% end %>
        <% end %>
        <%= link_to "Gear",
          inventory_path(category: "things", info: @info_mode),
          class: "nl-source-inventory-icon nl-source-inventory-icon--text",
          title: "Equipment" %>
        <%= link_to "Brief",
          inventory_path(category: @category, subcategory: @subcategory, info: "short"),
          class: "nl-source-inventory-icon nl-source-inventory-icon--text",
          title: "Short information" %>
        <%= link_to "Reset",
          inventory_path(info: @info_mode),
          class: "nl-source-inventory-icon nl-source-inventory-icon--text",
          title: "Reset filter" %>
      </nav>

      <div class="nl-source-inventory-mass">
        Inventory mass: <b><%= @inventory.current_weight %>/<%= @inventory.max_weight %></b>
      </div>

      <div id="inventory_grid">
        <% if inventory_family_sections(@category).any? && @items.empty? %>
          <%= render "inventories/family_sections", category: @category %>
        <% else %>
          <%= render "inventories/grid",
            items: @items,
            inventory: @inventory,
            category: @category,
            subcategory: @subcategory,
            info_mode: @info_mode %>
        <% end %>
      </div>
    </main>
  </div>
</section>
