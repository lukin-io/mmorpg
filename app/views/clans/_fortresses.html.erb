<h2><%= t("game.clans.tab_fortresses") %></h2>
<% if @clan.blank? %>
  <p class="nl-quests-board__meta"><%= t("game.clans.need_clan") %></p>
  <p class="nl-quests-board__meta" data-territory-cta="1">
    <%= t("game.clans.territory_cta") %>
    · <%= link_to t("game.buildings.clan_hall_short"), city_building_path("clan_hall"), class: "nl-sheet-link", data: {turbo_frame: "_top"} %>
    · <%= link_to t("game.wars.title"), wars_path, class: "nl-sheet-link", data: {turbo_frame: "_top"} %>
    · <%= link_to t("game.world.siege_battle_cta"), world_path, class: "nl-sheet-link", data: {turbo_frame: "_top"} %>
  </p>
<% elsif @fortresses.any? %>
  <% @fortresses.each do |fort| %>
    <article class="nl-clan-fort">
      <h3><%= fort.name %> (<%= fort.x %>,<%= fort.y %>)</h3>
      <% fort.ensure_default_buildings! %>
      <ul>
        <% fort.fortress_buildings.order(:building_key).each do |building| %>
          <li>
            <%= building.name %> — <%= t("game.clans.level", level: building.level) %>
            <% if @membership&.role.in?(%w[leader deputy]) %>
              <% cost = building.building_key == "laboratory" ? 150 + (building.level * 50) : 75 + (building.level * 50) %>
              <%= button_to "#{t("game.clans.upgrade")} (#{cost} NV)",
                    upgrade_building_clan_path,
                    method: :post,
                    params: {fortress_id: fort.id, building_id: building.id},
                    class: "lbut" %>
            <% end %>
          </li>
        <% end %>
      </ul>
    </article>
  <% end %>
<% else %>
  <p><%= t("game.clans.no_fortresses") %></p>
  <p class="nl-quests-board__meta" data-territory-cta="1">
    <%= t("game.clans.territory_cta") %>
    · <%= link_to t("game.wars.title"), wars_path, class: "nl-sheet-link", data: {turbo_frame: "_top"} %>
    · <%= link_to t("game.world.siege_battle_cta"), world_path, class: "nl-sheet-link", data: {turbo_frame: "_top"} %>
    · <%= link_to t("game.clans.alliance_title"), clan_path(tab: "manage"), class: "nl-sheet-link", data: {turbo_frame: "_top"} %>
  </p>
<% end %>
