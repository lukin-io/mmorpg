<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Neverlands" %></title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#fcfaf3">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "application", "controls", data: {turbo_track: "reload"} %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="nl-public-layout">
    <div id="flash" class="nl-public-flash">
      <% flash.each do |type, message| %>
        <div class="nl-flash nl-flash--<%= type %>"><%= message %></div>
      <% end %>
    </div>
    <main class="nl-public-main" id="game-main">
      <%= yield %>
    </main>
    <div id="notifications" class="nl-notifications"></div>
  </body>
</html>
