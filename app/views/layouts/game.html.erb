<!DOCTYPE html>
<html lang="en">
<head>
  <title><%= content_for(:title) || "RPG" %></title>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#fcfaf3">
  <% if @active_airship_journey || controller_name == "character_licenses" || (controller_name == "world" && @zone&.outdoor?) %>
    <%# Cached offers, license expiry and acquisition timestamps require a fresh read. %>
    <meta name="turbo-cache-control" content="no-cache">
  <% end %>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "application", "controls", data: { turbo_track: "reload" } %>
  <%= javascript_importmap_tags %>
</head>
<body class="nl-game-layout"
      data-controller="game-layout"
      data-action="nl-world-map:refreshed->game-layout#refreshPlayersList nl-world-map:refreshed->game-layout#refreshChat nl-world-map:movement-state->game-layout#updateWorldMovementState chat:context->game-layout#updateLocalChatContext"
      <% if controller_name == "world" && @zone&.outdoor? %>
        data-game-layout-encounter-url-value="<%= world_encounter_check_path %>"
      <% elsif current_character && controller_name != "arena_matches" && !@browsing_existing_fight_profile && !devise_controller? %>
        data-game-layout-encounter-url-value="<%= combat_status_path %>"
        data-game-layout-encounter-interval-value="5000"
      <% end %>>
  <% world_actions_locked = controller_name == "world" && (@active_movement.present? || @active_world_action.present?) %>

  <%# === TOP STATUS BAR (like original: name[lv] + HP/MP + text links) === %>
  <header class="nl-top-bar">
    <div class="sr-only" data-controller="online-reload" <%= online_reload_attributes %> aria-hidden="true"></div>
    <%# Left: Character name + level + HP/MP bars %>
    <div class="nl-top-left">
      <% if current_character %>
        <a href="<%= player_path(name: current_character.name) %>" class="nl-player-link">
          <%= current_character.name %></a><span class="nl-player-level">[<%= current_character.level %>]</span>
        <%= render "shared/nl_vitals_bar", character: current_character %>
        <% if current_character.character_injuries.active_at(Time.current).exists? %>
          <%= link_to "Injury", medical_care_path, class: "nl-injury-link", title: "Injuries and treatment" %>
        <% end %>
      <% end %>
    </div>

    <%# Right: Navigation text links (like original) %>
    <nav class="nl-top-nav">
      <% if current_character %>
        <% if controller_name == "players" %>
          <span class="nl-nav-link nl-nav-link--disabled" aria-current="page">Your character</span>
        <% else %>
          <%= button_to "Your character",
              world_context_action_path,
              method: :post,
              params: {context: "profile"},
              class: "nl-nav-link nl-nav-link--button",
              data: {game_layout_target: "worldNavigation"},
              disabled: world_actions_locked,
              form: {class: "nl-nav-action-form"} %>
        <% end %>
        <% if controller_name == "inventories" %>
          <span class="nl-nav-link nl-nav-link--disabled" aria-current="page">Inventory</span>
        <% else %>
          <%= button_to "Inventory",
              world_context_action_path,
              method: :post,
              params: {context: "inventory"},
              class: "nl-nav-link nl-nav-link--button",
              data: {game_layout_target: "worldNavigation"},
              disabled: world_actions_locked,
              form: {class: "nl-nav-action-form", data: {turbo_frame: ("main_content" if controller_name == "shop")}} %>
        <% end %>
        <% if @active_airship_journey %>
          <% unless controller_name == "airships" %>
            <%= link_to "Return", airship_path, class: "nl-nav-link", data: {turbo_frame: "_top"} %>
          <% end %>
        <% elsif controller_name == "world" %>
          <% if @zone&.outdoor? %>
            <%= turbo_frame_tag "available-actions", class: "nl-world-action-frame" do %>
              <%= render "world/actions", available_actions: @available_actions || [], position: @position %>
            <% end %>
          <% else %>
            <span class="nl-nav-link nl-nav-link--disabled" aria-current="page"><%= @zone&.display_name || "City" %></span>
          <% end %>
        <% elsif controller_name == "world_locations" %>
          <%= render "world_locations/navigation" %>
        <% elsif controller_name == "shop" %>
          <%= link_to shop_location_return_label, shop_location_return_path,
              class: "nl-nav-link", data: {turbo_frame: "_top"} %>
        <% else %>
          <%= button_to "Return",
              world_context_action_path,
              method: :post,
              params: {context: "world"},
              class: "nl-nav-link nl-nav-link--button",
              form: {class: "nl-nav-action-form"} %>
        <% end %>
      <% end %>
    </nav>

    <%# Far right: Close button %>
    <div class="nl-top-right">
      <% if user_signed_in? %>
        <%= link_to destroy_user_session_path,
            data: { turbo_method: :delete, turbo_confirm: "Exit the game?" },
            class: "nl-close-btn", title: "Exit" do %>X<% end %>
      <% end %>
    </div>
  </header>

  <%# Neverlands main_top frame: the only scrolling gameplay surface. %>
  <main class="nl-main-area" data-game-layout-target="mainContent">
    <%= turbo_frame_tag "main_content" do %>
      <% if content_for?(:main_content) %>
        <%= yield :main_content %>
      <% else %>
        <%= yield %>
      <% end %>
    <% end %>

  </main>

  <div class="nl-frame-resizer" aria-hidden="true"></div>

  <%# Neverlands chmain/ch_list frames translated into one persistent row. %>
  <section class="nl-social-row" aria-label="Chat and nearby players">
    <div class="nl-chat-history" id="chat-messages" data-game-layout-target="chatMessages">
      <% unless content_for?(:hide_shell_chat_history) %>
        <%= turbo_frame_tag "chat_messages", src: current_character ? local_chat_path : nil, loading: "lazy" do %>
          <div class="nl-chat-loading">Loading...</div>
        <% end %>
      <% end %>
    </div>

    <aside class="nl-players-float" data-game-layout-target="playersPanel">
      <div class="nl-players-header-float">
        <span class="nl-sort-links">
          Sort:
          <a href="#" data-action="click->game-layout#sortPlayers" data-sort="az">a-z</a>
          <a href="#" data-action="click->game-layout#sortPlayers" data-sort="za">z-a</a>
          <a href="#" data-action="click->game-layout#sortPlayers" data-sort="lvl-asc">0-33</a>
          <a href="#" data-action="click->game-layout#sortPlayers" data-sort="lvl-desc">33-0</a>
        </span>
        <label class="nl-refresh-check">
          <input type="checkbox" checked data-action="change->game-layout#toggleAutoRefresh">
          <span class="nl-refresh-image">refresh</span>
        </label>
      </div>
      <div class="nl-players-location">
        <span class="nl-location-text" data-game-layout-target="playersLocation"><%= @presence_location_label || @position&.zone&.name || "Unknown" %> [ <%= @presence_player_count || @players_here&.size || 0 %> ]</span>
        <span class="nl-total-online" data-game-layout-target="playersTotal">Total [ <%= @total_online.to_i %> ]</span>
      </div>
      <div class="nl-players-list-float" data-game-layout-target="playersList">
        <%= render "shared/nl_players_list" %>
      </div>
    </aside>
  </section>

  <div class="nl-frame-separator" aria-hidden="true"></div>

  <%# Compact game-owned chat controls using text and CSS only. %>
  <footer class="nl-bottom-bar" data-game-layout-target="bottomBar">
    <div class="nl-action-area">
      <label class="nl-action-check"><input type="checkbox"> Action</label>
      <button type="button" class="nl-chat-image-button nl-chat-image-button--say" data-action="click->game-layout#focusChat" title="Say">Say</button>
    </div>

    <div class="nl-chat-input-bar" data-game-layout-target="chatArea">
      <% unless content_for?(:hide_shell_chat_composer) %>
        <% if current_character %>
          <%= form_with url: local_chat_path,
                        method: :post,
                        scope: :chat_message,
                        class: "nl-chat-form-inline",
                        data: { controller: "chat-input", action: "turbo:submit-end->chat-input#reset" } do |f| %>
            <%= hidden_field_tag :context_key, current_character.metadata.to_h.dig("local_chat_context", "key") %>
            <%= f.text_field :body,
                class: "nl-chat-input-field",
                placeholder: "",
                maxlength: 250,
                autocomplete: "off",
                data: {
                  game_layout_target: "chatInput",
                  chat_input_target: "input",
                  action: "keydown->chat-input#handleKeydown"
                } %>
          <% end %>
        <% end %>
      <% end %>
    </div>

    <div class="nl-chat-toolstrip" aria-label="Chat controls">
      <button type="button" class="nl-chat-tool nl-chat-tool--send" aria-label="Send message" title="Send message" data-action="click->game-layout#sendChat">&gt;</button>
      <button type="button" class="nl-chat-tool nl-chat-tool--clear-input" aria-label="Clear input" title="Clear input" data-action="click->game-layout#clearChatInput">X</button>
      <button type="button" class="nl-chat-tool nl-chat-tool--smiles-one" aria-label="Emoticons" title="Emoticons">:)</button>
      <button type="button" class="nl-chat-tool nl-chat-tool--smiles-two" aria-label="More emoticons" title="More emoticons">:D</button>
      <button type="button" class="nl-chat-tool nl-chat-tool--refresh" aria-label="Refresh chat" title="Refresh chat" data-action="click->game-layout#refreshChat">R</button>
      <button type="button" class="nl-chat-tool nl-chat-tool--clear-chat" aria-label="Clear chat" title="Clear chat" data-action="click->game-layout#clearChat">X</button>
      <button type="button" class="nl-chat-tool nl-chat-tool--messages" aria-label="Show all messages" title="Show all messages">All</button>
      <button type="button" class="nl-chat-tool nl-chat-tool--speed" aria-label="Refresh every 10 seconds" title="Refresh every 10 seconds">10s</button>
      <button type="button" class="nl-chat-tool nl-chat-tool--language" aria-label="Text mode" title="Text mode">Aa</button>
    </div>

    <div class="nl-status-icons">
      <span class="nl-time-display"><%= Time.current.strftime("%H:%M:%S") %></span>
      <% if current_character %>
        <%= link_to "A", character_licenses_path, class: "nl-chat-tool nl-chat-tool--abilities", aria: {label: "Abilities"}, title: "Abilities", data: {turbo_frame: "_top"} %>
      <% end %>
    </div>
  </footer>

  <%# Flash messages %>
  <div class="nl-flash-container" id="flash">
    <% flash.to_hash.except("world_action_result", "world_action_result_offer_id", "scroll_error").each do |type, message| %>
      <%= render "shared/flash", type:, message: %>
    <% end %>
  </div>

</body>
</html>
