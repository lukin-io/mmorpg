<% content_for :title, "#{@character.name} - Character" %>

<section class="nl-player-profile nl-source-character-page">
  <div class="nl-visually-hidden" aria-live="polite">
    <h1><%= @character.name %> [<%= @character.level %>]</h1>
    <p><%= profile_location(@character) %></p>
    <% if @character.owned_perk_keys.any? %>
      <h2>Perks</h2>
      <ul>
        <% @character.owned_perk_keys.each do |perk_key| %>
          <% definition = Game::Skills::PerkRegistry.find(perk_key) %>
          <li><%= definition[:name] %></li>
        <% end %>
      </ul>
    <% end %>
  </div>
  <div class="nl-source-character-grid">
    <aside class="nl-source-character-left">
      <%= render "shared/neverlands_character_sheet",
        character: @character,
        equipment: @equipment,
        interactive: false,
        show_money: @own_profile %>
    </aside>

    <main class="nl-source-character-right">
      <%= render "shared/neverlands_profile_navigation", character: @character %>

      <% if @own_profile && @character.stat_points_available.to_i.positive? %>
        <turbo-frame id="stat-allocation" class="nl-source-allocation">
          <%= render "characters/stat_allocation" %>
        </turbo-frame>
      <% end %>

    </main>
  </div>
</section>
