<% if record.errors.any? %>
  <div class="nl-manage-errors" role="alert">
    <strong><%= t("manage.views.errors_prevented", count: record.errors.count) %></strong>
    <ul>
      <% record.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
