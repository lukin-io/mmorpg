<% if pagination.total_pages > 1 %>
  <nav class="nl-manage-pagination" aria-label="<%= t("manage.pagination_aria") %>">
    <% if pagination.previous_page %>
      <%= link_to t("manage.previous_page"), url_for(request.query_parameters.merge(page: pagination.previous_page)), class: "lbut" %>
    <% else %>
      <span class="lbutdis" aria-disabled="true"><%= t("manage.previous_page") %></span>
    <% end %>
    <span><%= t("manage.page_of", page: pagination.page, total: pagination.total_pages, count: pagination.total_count) %></span>
    <% if pagination.next_page %>
      <%= link_to t("manage.next_page"), url_for(request.query_parameters.merge(page: pagination.next_page)), class: "lbut" %>
    <% else %>
      <span class="lbutdis" aria-disabled="true"><%= t("manage.next_page") %></span>
    <% end %>
  </nav>
<% end %>
