<%= render "manage/shared/page_header", title: @tile_npc.display_name, description: @tile_npc.npc_key %>
<table class="nl-sheet-table nl-manage-detail">
  <tr><th><%= t("manage.views.encounter_active") %></th><td><%= management_boolean(@tile_npc.active?) %></td></tr>
  <tr><th><%= t("manage.views.col_cell") %></th><td><%= @tile_npc.zone %> [<%= @tile_npc.x %>, <%= @tile_npc.y %>]</td></tr><tr><th><%= t("manage.views.template") %></th><td><%= @tile_npc.npc_template.name %></td></tr>
  <tr><th><%= t("manage.views.role_level") %></th><td><%= management_enum_label(:npc_role, @tile_npc.npc_role) %> / <%= @tile_npc.level %></td></tr><tr><th><%= t("manage.views.col_hp") %></th><td><%= @tile_npc.current_hp %>/<%= @tile_npc.max_hp %></td></tr>
  <tr><th><%= t("manage.views.defeated_at") %></th><td><%= @tile_npc.defeated_at || "—" %></td></tr><tr><th><%= t("manage.views.respawns_at") %></th><td><%= @tile_npc.respawns_at || "—" %></td></tr>
</table>
<h2 class="invtitle"><%= t("manage.views.metadata_heading") %></h2><pre class="nl-manage-json"><%= pretty_json(@tile_npc.metadata) %></pre>
<%= render "manage/shared/record_actions", edit_path: edit_manage_tile_npc_path(@tile_npc),
      delete_path: manage_tile_npc_path(@tile_npc), back_path: manage_tile_npcs_path %>
