<details data-manage-collection-target="row">
  <summary><%= sample["key"].presence || t("manage.views.new_encounter_roster") %></summary>
  <% prefix = "tile_npc[rosters][#{index}]" %>
  <% field_id = "roster_#{index}" %>
  <div class="nl-manage-field-grid">
    <div class="nl-manage-field"><%= label_tag "#{field_id}_key", t("manage.views.roster_key") %><%= text_field_tag "#{prefix}[key]", sample["key"], id: "#{field_id}_key" %></div>
    <% {
      "weight" => t("manage.views.selection_weight"),
      "encounter_experience_reward" => t("manage.views.encounter_xp"),
      "trauma_percent" => t("manage.views.injury_percent")
    }.each do |key, label| %>
      <div class="nl-manage-field"><%= label_tag "#{field_id}_#{key}", label %><%= number_field_tag "#{prefix}[#{key}]", sample[key], id: "#{field_id}_#{key}", min: key == "weight" ? 1 : 0 %></div>
    <% end %>
  </div>
  <p class="nl-manage-help"><%= t("manage.views.help_roster_members") %></p>
  <% TileNpc::MAX_ENCOUNTER_SIZE.times do |member_index| %>
    <% member = Array(sample["members"])[member_index].to_h %>
    <% member_prefix = "#{prefix}[members][#{member_index}]" %>
    <% member_id = "#{field_id}_member_#{member_index}" %>
    <fieldset class="nl-manage-field-grid">
      <legend><%= t("manage.views.member_n", n: member_index + 1) %></legend>
      <div class="nl-manage-field"><%= label_tag "#{member_id}_npc_key", t("manage.views.npc_template") %><%= select_tag "#{member_prefix}[npc_key]", options_from_collection_for_select(@npc_templates, :npc_key, :name, member["npc_key"]), include_blank: t("manage.views.unused_member"), id: "#{member_id}_npc_key" %></div>
      <% {
        "level" => t("manage.views.exact_level"),
        "level_min" => t("manage.views.minimum_level"),
        "level_max" => t("manage.views.maximum_level"),
        "hp" => t("manage.views.col_hp")
      }.each do |key, label| %>
        <div class="nl-manage-field"><%= label_tag "#{member_id}_#{key}", label %><%= number_field_tag "#{member_prefix}[#{key}]", member[key], id: "#{member_id}_#{key}", min: key == "hp" ? 1 : 0 %></div>
      <% end %>
    </fieldset>
  <% end %>
  <button type="button" class="lbut" data-action="manage-collection#remove"><%= t("manage.views.remove_roster") %></button>
</details>
