<%= render "manage/shared/errors", record: tile_npc %>
<%= form_with model: tile_npc, url:, class: "nl-manage-form" do |form| %>
  <%= hidden_field_tag "tile_npc[content_fields]", "1" %>
  <div class="nl-manage-field-grid">
    <div class="nl-manage-field"><%= form.label :zone %><%= form.collection_select :zone, @outdoor_zones, :name, :name, prompt: "Select an outdoor zone" %></div>
    <div class="nl-manage-field"><%= form.label :npc_template_id %><%= form.collection_select :npc_template_id, @npc_templates, :id, :name, prompt: "Select an NPC template" %></div>
    <div class="nl-manage-field"><%= form.label :x %><%= form.number_field :x, min: 0, required: true %></div>
    <div class="nl-manage-field"><%= form.label :y %><%= form.number_field :y, min: 0, required: true %></div>
    <div class="nl-manage-field"><%= form.label :npc_key %><%= form.text_field :npc_key, required: true %></div>
    <div class="nl-manage-field"><%= form.label :npc_role %><%= form.select :npc_role, TileNpc::NPC_ROLES %></div>
    <div class="nl-manage-field"><%= form.label :level %><%= form.number_field :level, min: 1, required: true %></div>
    <div class="nl-manage-field"><%= form.label :active, "Encounter active" %><%= form.check_box :active %></div>
    <div class="nl-manage-field"><%= label_tag "tile_npc_encounter_count", "Fixed encounter size" %><%= number_field_tag "tile_npc[encounter_count]", tile_npc.encounter_size, id: "tile_npc_encounter_count", min: 1, max: TileNpc::MAX_ENCOUNTER_SIZE %></div>
    <div class="nl-manage-field"><%= form.label :current_hp %><%= form.number_field :current_hp, min: 0 %></div>
    <div class="nl-manage-field"><%= form.label :max_hp %><%= form.number_field :max_hp, min: 0 %></div>
    <div class="nl-manage-field"><%= form.label :defeated_at %><%= form.datetime_local_field :defeated_at %></div>
    <div class="nl-manage-field"><%= form.label :respawns_at %><%= form.datetime_local_field :respawns_at %></div>
    <div class="nl-manage-field nl-manage-field--wide">
      <%= form.label :metadata %><%= form.text_area :metadata, value: pretty_json(tile_npc.metadata.to_h.except("active", "encounter_count", "encounter_rosters")), spellcheck: false %>
      <small class="nl-manage-help">Advanced encounter data, captured passive delay windows and source references. Edit activation, fixed size, and complete rosters with their dedicated controls.</small>
    </div>
  </div>
  <fieldset data-controller="manage-collection" data-manage-collection-next-index-value="<%= tile_npc.encounter_roster_samples.length %>" data-manage-collection-limit-value="<%= TileNpc::MAX_ROSTER_SAMPLES %>">
    <legend>Complete encounter rosters</legend>
    <p class="nl-manage-help">Without rosters, the fixed template, level and size above apply. With rosters, one complete group is selected. Deactivation preserves all authored data.</p>
    <div data-manage-collection-target="rows"><% tile_npc.encounter_roster_samples.each_with_index do |sample, index| %><%= render "roster", sample:, index: %><% end %></div>
    <template data-manage-collection-target="template"><%= render "roster", sample: {}, index: "NEW_ROW" %></template>
    <button type="button" class="lbut" data-action="manage-collection#add">Add encounter roster</button>
  </fieldset>
  <%= render "manage/shared/form_actions", form:, submit_label:, cancel_path: %>
<% end %>
