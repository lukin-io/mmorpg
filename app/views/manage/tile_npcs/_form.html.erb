<%= render "manage/shared/errors", record: tile_npc %>
<%= form_with model: tile_npc, url:, class: "nl-manage-form" do |form| %>
  <%= hidden_field_tag "tile_npc[content_fields]", "1" %>
  <div class="nl-manage-field-grid">
    <div class="nl-manage-field"><%= form.label :zone, t("manage.views.col_zone") %><%= form.collection_select :zone, @outdoor_zones, :name, :name, prompt: t("manage.views.select_outdoor_zone") %></div>
    <div class="nl-manage-field"><%= form.label :npc_template_id, t("manage.views.attr_npc_template") %><%= form.collection_select :npc_template_id, @npc_templates, :id, :name, prompt: t("manage.views.select_npc_template") %></div>
    <div class="nl-manage-field"><%= form.label :x, t("manage.views.attr_x") %><%= form.number_field :x, min: 0, required: true %></div>
    <div class="nl-manage-field"><%= form.label :y, t("manage.views.attr_y") %><%= form.number_field :y, min: 0, required: true %></div>
    <div class="nl-manage-field"><%= form.label :npc_key, t("manage.views.attr_npc_key") %><%= form.text_field :npc_key, required: true %></div>
    <div class="nl-manage-field"><%= form.label :npc_role, t("manage.views.attr_npc_role") %><%= form.select :npc_role, management_enum_options(:npc_role, TileNpc::NPC_ROLES) %></div>
    <div class="nl-manage-field"><%= form.label :level, t("manage.views.col_level") %><%= form.number_field :level, min: 0, required: true %></div>
    <div class="nl-manage-field"><%= form.label :active, t("manage.views.encounter_active") %><%= form.check_box :active %></div>
    <div class="nl-manage-field"><%= label_tag "tile_npc_encounter_count", t("manage.views.fixed_encounter_size") %><%= number_field_tag "tile_npc[encounter_count]", tile_npc.encounter_size, id: "tile_npc_encounter_count", min: 1, max: TileNpc::MAX_ENCOUNTER_SIZE %></div>
    <div class="nl-manage-field"><%= form.label :current_hp, t("manage.views.attr_current_hp") %><%= form.number_field :current_hp, min: 0 %></div>
    <div class="nl-manage-field"><%= form.label :max_hp, t("manage.views.attr_max_hp") %><%= form.number_field :max_hp, min: 0 %></div>
    <div class="nl-manage-field"><%= form.label :defeated_at, t("manage.views.defeated_at") %><%= form.datetime_local_field :defeated_at %></div>
    <div class="nl-manage-field"><%= form.label :respawns_at, t("manage.views.respawns_at") %><%= form.datetime_local_field :respawns_at %></div>
    <div class="nl-manage-field">
      <%= label_tag "tile_npc_respawn_seconds", t("manage.views.respawn_seconds") %>
      <%= number_field_tag "tile_npc[respawn_seconds]", tile_npc.metadata.to_h["respawn_seconds"], id: "tile_npc_respawn_seconds", min: 30, max: 86_400 %>
    </div>
    <div class="nl-manage-field">
      <%= label_tag "tile_npc_drop_chance_multiplier", t("manage.views.drop_chance_multiplier") %>
      <%= number_field_tag "tile_npc[drop_chance_multiplier]", tile_npc.metadata.to_h["drop_chance_multiplier"] || 1.0, id: "tile_npc_drop_chance_multiplier", min: 0.1, max: 5, step: 0.1 %>
    </div>
    <div class="nl-manage-field nl-manage-field--wide">
      <%= form.label :metadata, t("manage.views.attr_metadata") %><%= form.text_area :metadata, value: pretty_json(tile_npc.metadata.to_h.except("active", "encounter_count", "encounter_rosters", "respawn_seconds", "drop_chance_multiplier")), spellcheck: false %>
      <small class="nl-manage-help"><%= t("manage.views.help_tile_npc_metadata") %></small>
    </div>
  </div>
  <fieldset data-controller="manage-collection" data-manage-collection-next-index-value="<%= tile_npc.encounter_roster_samples.length %>" data-manage-collection-limit-value="<%= TileNpc::MAX_ROSTER_SAMPLES %>">
    <legend><%= t("manage.views.complete_rosters_legend") %></legend>
    <p class="nl-manage-help"><%= t("manage.views.help_tile_npc_rosters") %></p>
    <div data-manage-collection-target="rows"><% tile_npc.encounter_roster_samples.each_with_index do |sample, index| %><%= render "roster", sample:, index: %><% end %></div>
    <template data-manage-collection-target="template"><%= render "roster", sample: {}, index: "NEW_ROW" %></template>
    <button type="button" class="lbut" data-action="manage-collection#add"><%= t("manage.views.add_encounter_roster") %></button>
  </fieldset>
  <%= render "manage/shared/form_actions", form:, submit_label:, cancel_path: %>
<% end %>
