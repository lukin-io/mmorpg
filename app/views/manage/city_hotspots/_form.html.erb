<%= render "manage/shared/errors", record: city_hotspot %>
<%= form_with model: city_hotspot, url:, class: "nl-manage-form" do |form| %>
  <div class="nl-manage-field-grid">
    <div class="nl-manage-field"><%= form.label :zone_id, t("manage.views.city_node") %><%= form.collection_select :zone_id, @cities, :id, :display_name, prompt: t("manage.views.select_city_node") %></div>
    <div class="nl-manage-field"><%= form.label :key, t("manage.views.col_key") %><%= form.text_field :key, required: true %></div>
    <div class="nl-manage-field"><%= form.label :name, t("manage.views.col_name") %><%= form.text_field :name, required: true %></div>
    <div class="nl-manage-field"><%= form.label :hotspot_type, t("manage.views.attr_hotspot_type") %><%= form.select :hotspot_type, management_enum_options(:hotspot_type, CityHotspot::HOTSPOT_TYPES) %></div>
    <div class="nl-manage-field"><%= form.label :action_type, t("manage.views.attr_action_type") %><%= form.select :action_type, management_enum_options(:action_type, CityHotspot::ACTION_TYPES) %></div>
    <div class="nl-manage-field"><%= form.label :destination_zone_id, t("manage.views.attr_destination_zone") %><%= form.collection_select :destination_zone_id, @destination_zones, :id, :display_name, include_blank: t("manage.views.no_destination_zone") %></div>
    <div class="nl-manage-field"><%= form.label :position_x, t("manage.views.attr_position_x") %><%= form.number_field :position_x, min: 0, required: true %></div>
    <div class="nl-manage-field"><%= form.label :position_y, t("manage.views.attr_position_y") %><%= form.number_field :position_y, min: 0, required: true %></div>
    <div class="nl-manage-field"><%= form.label :width, t("manage.views.attr_width") %><%= form.number_field :width, min: 1 %></div>
    <div class="nl-manage-field"><%= form.label :height, t("manage.views.attr_height") %><%= form.number_field :height, min: 1 %></div>
    <div class="nl-manage-field"><%= form.label :required_level, t("manage.views.required_level") %><%= form.number_field :required_level, min: 0 %></div>
    <div class="nl-manage-field"><%= form.label :z_index, t("manage.views.attr_z_index") %><%= form.number_field :z_index %></div>
    <div class="nl-manage-field"><%= form.label :active, t("manage.views.col_active") %><%= form.check_box :active %></div>
    <div class="nl-manage-field nl-manage-field--wide">
      <%= form.label :action_params, t("manage.views.attr_action_params") %><%= form.text_area :action_params, value: pretty_json(city_hotspot.action_params), spellcheck: false %>
      <small class="nl-manage-help"><%= t("manage.views.help_hotspot_params_html").html_safe %></small>
    </div>
  </div>
  <%= render "manage/shared/form_actions", form:, submit_label:, cancel_path: %>
<% end %>
