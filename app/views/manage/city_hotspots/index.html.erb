<% content_for :title, "#{t('manage.views.city_actions_title')} · #{t('manage.title')}" %>
<%= render "manage/shared/page_header", title: t("manage.views.city_actions_title"), description: t("manage.views.city_actions_hint"), new_path: new_manage_city_hotspot_path, new_label: t("manage.views.create_city_action") %>

<%= form_with url: manage_city_hotspots_path, method: :get, class: "nl-manage-filter", local: true do |form| %>
  <%= form.label :zone_id, t("manage.views.city_node") %><%= form.select :zone_id, options_from_collection_for_select(@cities, :id, :display_name, params[:zone_id]), include_blank: t("manage.views.all_city_nodes") %>
  <%= form.submit t("manage.filter"), class: "lbut" %><%= link_to t("manage.clear"), manage_city_hotspots_path, class: "lbut" %>
<% end %>

<div class="nl-manage-table-wrap"><table class="nl-manage-table">
  <thead><tr><th><%= t("manage.views.city_node") %></th><th><%= t("manage.views.col_key") %></th><th><%= t("manage.views.col_name") %></th><th><%= t("manage.views.col_type") %></th><th><%= t("manage.views.col_action") %></th><th><%= t("manage.views.col_geometry") %></th><th><%= t("manage.views.col_active") %></th><th><%= t("manage.views.col_actions") %></th></tr></thead>
  <tbody>
    <% @city_hotspots.each do |hotspot| %>
      <tr><td><%= hotspot.zone.display_name %></td><td><%= hotspot.key %></td><td><%= hotspot.name %></td><td><%= management_enum_label(:hotspot_type, hotspot.hotspot_type) %></td><td><%= management_enum_label(:action_type, hotspot.action_type) %></td>
        <td><%= hotspot.position_x %>,<%= hotspot.position_y %> · <%= hotspot.width || "—" %>×<%= hotspot.height || "—" %></td><td><%= management_boolean(hotspot.active?) %></td>
        <td class="nl-manage-table-actions"><%= link_to t("manage.view"), manage_city_hotspot_path(hotspot) %> <%= link_to t("manage.edit"), edit_manage_city_hotspot_path(hotspot) %></td></tr>
    <% end %>
    <% if @city_hotspots.empty? %><tr><td colspan="8" class="nl-manage-empty"><%= t("manage.views.empty_city_actions") %></td></tr><% end %>
  </tbody>
</table></div>
<%= render "manage/shared/pagination", pagination: @pagination %>
