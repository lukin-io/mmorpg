<%= render "manage/shared/page_header", title: @city_hotspot.name, description: "#{@city_hotspot.zone.display_name} · #{@city_hotspot.key}" %>
<table class="nl-sheet-table nl-manage-detail">
  <tr><th><%= t("manage.views.type_action") %></th><td><%= management_enum_label(:hotspot_type, @city_hotspot.hotspot_type) %> / <%= management_enum_label(:action_type, @city_hotspot.action_type) %></td></tr>
  <tr><th><%= t("manage.views.col_destination") %></th><td><%= @city_hotspot.destination_zone&.display_name || t("manage.views.feature_route") %></td></tr>
  <tr><th><%= t("manage.views.col_geometry") %></th><td><%= @city_hotspot.position_x %>, <%= @city_hotspot.position_y %> · <%= @city_hotspot.width || "—" %> × <%= @city_hotspot.height || "—" %></td></tr>
  <tr><th><%= t("manage.views.required_level") %></th><td><%= @city_hotspot.required_level %></td></tr><tr><th><%= t("manage.views.col_active") %></th><td><%= management_boolean(@city_hotspot.active?) %></td></tr>
</table>
<h2 class="invtitle"><%= t("manage.views.action_params_heading") %></h2><pre class="nl-manage-json"><%= pretty_json(@city_hotspot.action_params) %></pre>
<%= render "manage/shared/record_actions", edit_path: edit_manage_city_hotspot_path(@city_hotspot),
      delete_path: manage_city_hotspot_path(@city_hotspot), back_path: manage_city_hotspots_path %>
