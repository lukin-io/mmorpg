<%= render "manage/shared/errors", record: tile_building %>
<%= form_with model: tile_building, url:, class: "nl-manage-form" do |form| %>
  <div class="nl-manage-field-grid">
    <div class="nl-manage-field"><%= form.label :zone, "Source zone" %><%= form.collection_select :zone, @outdoor_zones, :name, :name, prompt: "Select an outdoor zone" %></div>
    <div class="nl-manage-field"><%= form.label :building_key %><%= form.text_field :building_key, required: true %></div>
    <div class="nl-manage-field"><%= form.label :x %><%= form.number_field :x, min: 0, required: true %></div>
    <div class="nl-manage-field"><%= form.label :y %><%= form.number_field :y, min: 0, required: true %></div>
    <div class="nl-manage-field"><%= form.label :name %><%= form.text_field :name, required: true %></div>
    <div class="nl-manage-field"><%= form.label :building_type %><%= form.select :building_type, TileBuilding::BUILDING_TYPES %></div>
    <div class="nl-manage-field"><%= form.label :destination_zone_id %><%= form.collection_select :destination_zone_id, @destination_zones, :id, :display_name, include_blank: "No zone (linked location)" %></div>
    <div class="nl-manage-field"><%= form.label :required_level %><%= form.number_field :required_level, min: 0 %></div>
    <div class="nl-manage-field"><%= form.label :destination_x %><%= form.number_field :destination_x, min: 0 %></div>
    <div class="nl-manage-field"><%= form.label :destination_y %><%= form.number_field :destination_y, min: 0 %></div>
    <div class="nl-manage-field"><%= form.label :active %><%= form.check_box :active %></div>
    <div class="nl-manage-field nl-manage-field--wide">
      <%= form.label :metadata %><%= form.text_area :metadata, value: pretty_json(tile_building.metadata), spellcheck: false %>
      <small class="nl-manage-help">City gates use destination zone/x/y. Linked locations use a validated <code>location</code> object with scene size and feature polygons.</small>
    </div>
  </div>
  <%= render "manage/shared/form_actions", form:, submit_label:, cancel_path: %>
<% end %>
