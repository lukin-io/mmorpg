<%= render "manage/shared/page_header", title: @npc_template.name, description: @npc_template.npc_key.presence || t("manage.views.no_stable_key") %>
<table class="nl-sheet-table nl-manage-detail">
  <tr><th><%= t("manage.views.role") %></th><td><%= management_enum_label(:npc_role, @npc_template.role) %></td></tr><tr><th><%= t("manage.views.col_level") %></th><td><%= @npc_template.level %></td></tr>
  <tr><th><%= t("manage.views.col_hp") %></th><td><%= @npc_template.max_hp %></td></tr><tr><th><%= t("manage.views.col_attack") %></th><td><%= @npc_template.attack_power %></td></tr>
  <tr><th><%= t("manage.views.col_placements") %></th><td><%= @npc_template.tile_npcs.size %></td></tr><tr><th><%= t("manage.views.dialogue") %></th><td><%= @npc_template.dialogue %></td></tr>
</table>
<h2 class="invtitle"><%= t("manage.views.metadata_heading") %></h2><pre class="nl-manage-json"><%= pretty_json(@npc_template.metadata) %></pre>
<%= render "manage/shared/record_actions", edit_path: edit_manage_npc_template_path(@npc_template),
      delete_path: manage_npc_template_path(@npc_template), back_path: manage_npc_templates_path %>
