<%= render "manage/shared/errors", record: npc_template %>
<%= form_with model: npc_template, url:, class: "nl-manage-form" do |form| %>
  <div class="nl-manage-field-grid">
    <div class="nl-manage-field"><%= form.label :npc_key, t("manage.views.attr_npc_key") %><%= form.text_field :npc_key %></div>
    <div class="nl-manage-field"><%= form.label :name, t("manage.views.col_name") %><%= form.text_field :name, required: true %></div>
    <div class="nl-manage-field">
      <%= label_tag "#{form.object_name}_npc_role", t("manage.views.role") %>
      <%= select_tag "#{form.object_name}[npc_role]", options_for_select(management_enum_options(:npc_role, NpcTemplate::ROLES), npc_template.role), id: "#{form.object_name}_npc_role" %>
    </div>
    <div class="nl-manage-field"><%= form.label :level, t("manage.views.col_level") %><%= form.number_field :level, min: 0, required: true %></div>
    <div class="nl-manage-field nl-manage-field--wide"><%= form.label :dialogue, t("manage.views.dialogue") %><%= form.text_area :dialogue, rows: 3, class: "nl-manage-short-textarea" %></div>
    <div class="nl-manage-field nl-manage-field--wide">
      <%= form.label :metadata, t("manage.views.attr_metadata") %><%= form.text_area :metadata, value: pretty_json(npc_template.metadata), spellcheck: false %>
      <small class="nl-manage-help"><%= t("manage.views.help_npc_template_html").html_safe %></small>
    </div>
  </div>
  <%= render "manage/shared/form_actions", form:, submit_label:, cancel_path: %>
<% end %>
