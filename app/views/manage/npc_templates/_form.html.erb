<%= render "manage/shared/errors", record: npc_template %>
<%= form_with model: npc_template, url:, class: "nl-manage-form" do |form| %>
  <div class="nl-manage-field-grid">
    <div class="nl-manage-field"><%= form.label :npc_key %><%= form.text_field :npc_key %></div>
    <div class="nl-manage-field"><%= form.label :name %><%= form.text_field :name, required: true %></div>
    <div class="nl-manage-field">
      <%= label_tag "#{form.object_name}_npc_role", "Role" %>
      <%= select_tag "#{form.object_name}[npc_role]", options_for_select(NpcTemplate::ROLES, npc_template.role), id: "#{form.object_name}_npc_role" %>
    </div>
    <div class="nl-manage-field"><%= form.label :level %><%= form.number_field :level, min: 1, required: true %></div>
    <div class="nl-manage-field nl-manage-field--wide"><%= form.label :dialogue %><%= form.text_area :dialogue, rows: 3, class: "nl-manage-short-textarea" %></div>
    <div class="nl-manage-field nl-manage-field--wide">
      <%= form.label :metadata %><%= form.text_area :metadata, value: pretty_json(npc_template.metadata), spellcheck: false %>
      <small class="nl-manage-help">Combat values remain explicit: for example <code>health</code>, <code>base_damage</code>, <code>xp_reward</code>, <code>loot_table</code>, and optional respawn timing.</small>
    </div>
  </div>
  <%= render "manage/shared/form_actions", form:, submit_label:, cancel_path: %>
<% end %>
