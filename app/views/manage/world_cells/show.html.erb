<%= render "manage/shared/page_header", title: t("manage.views.world_cell"), description: "#{@world_cell.zone} [#{@world_cell.x}, #{@world_cell.y}]" %>
<table class="nl-sheet-table nl-manage-detail">
  <tr><th><%= t("manage.views.col_terrain") %></th><td><%= management_enum_label(:terrain_type, @world_cell.terrain_type) %></td></tr>
  <tr><th><%= t("manage.views.col_passable") %></th><td><%= management_boolean(@world_cell.passable?) %></td></tr>
  <tr><th><%= t("manage.views.local_actions_resources") %></th><td><%= @world_cell.local_actions.map { |action| action["label"].presence || action["type"] }.join(", ").presence || t("manage.views.none_value") %></td></tr>
  <tr><th><%= t("manage.views.resource_groups_legend") %></th><td><%= @world_cell.resource_groups.map { |group| "#{group['label']} (#{group['key']}; #{group['active'] == false ? t('manage.views.group_inactive_word') : t('manage.views.group_active_word')})" }.join(", ").presence || t("manage.views.none_value") %></td></tr>
  <tr><th><%= t("manage.views.col_updated") %></th><td><%= l(@world_cell.updated_at, format: :long) %></td></tr>
</table>
<p>
  <% address = {zone: @world_cell.zone, x: @world_cell.x, y: @world_cell.y} %>
  <%= link_to t("manage.views.manage_cell_npcs"), @cell_npc ? edit_manage_tile_npc_path(@cell_npc) : new_manage_tile_npc_path(**address), class: "lbut" %>
  <%= link_to t("manage.views.manage_cell_entrance"), @cell_building ? edit_manage_tile_building_path(@cell_building) : new_manage_tile_building_path(**address), class: "lbut" %>
</p>
<h2 class="invtitle"><%= t("manage.views.metadata_heading") %></h2>
<pre class="nl-manage-json"><%= pretty_json(@world_cell.metadata) %></pre>
<%= render "manage/shared/record_actions",
      edit_path: edit_manage_world_cell_path(@world_cell), delete_path: manage_world_cell_path(@world_cell),
      back_path: manage_world_cells_path %>
