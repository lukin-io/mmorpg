<fieldset class="nl-manage-field-grid" data-manage-collection-target="row">
  <legend><%= t("manage.views.resource_group") %></legend>
  <% prefix = "map_tile_template[resource_groups][#{index}]" %>
  <% field_id = "resource_group_#{index}" %>
  <div class="nl-manage-field"><%= label_tag "#{field_id}_key", t("manage.views.group_key") %><%= text_field_tag "#{prefix}[key]", group["key"], id: "#{field_id}_key", maxlength: 80, placeholder: "herbs_7" %></div>
  <div class="nl-manage-field"><%= label_tag "#{field_id}_kind", t("manage.views.resource_kind") %><%= text_field_tag "#{prefix}[kind]", group["kind"], id: "#{field_id}_kind", maxlength: 80, placeholder: "herbs" %></div>
  <div class="nl-manage-field"><%= label_tag "#{field_id}_label", t("manage.views.group_label") %><%= text_field_tag "#{prefix}[label]", group["label"], id: "#{field_id}_label", maxlength: 120 %></div>
  <div class="nl-manage-field"><%= label_tag "#{field_id}_active", t("manage.views.group_active") %><%= hidden_field_tag "#{prefix}[active]", "0" %><%= check_box_tag "#{prefix}[active]", "1", group["active"] != false, id: "#{field_id}_active" %></div>
  <button type="button" class="lbut" data-action="manage-collection#remove"><%= t("manage.views.remove_group") %></button>
</fieldset>
