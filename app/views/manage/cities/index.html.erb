<% content_for :title, "#{t('manage.views.city_nodes_title')} · #{t('manage.title')}" %>
<%= render "manage/shared/page_header", title: t("manage.views.city_nodes_title"), description: t("manage.views.city_nodes_hint"), new_path: new_manage_city_path, new_label: t("manage.views.create_city_node") %>
<div class="nl-manage-table-wrap"><table class="nl-manage-table">
  <thead><tr><th><%= t("manage.views.col_city_key") %></th><th><%= t("manage.views.col_node_key") %></th><th><%= t("manage.views.col_title") %></th><th><%= t("manage.views.col_zone_name") %></th><th><%= t("manage.views.col_size") %></th><th><%= t("manage.views.col_actions") %></th></tr></thead>
  <tbody>
    <% @cities.each do |city| %>
      <tr><td><%= city.metadata.to_h["city_key"].presence || "—" %></td><td><%= city.city_node_key.presence || "—" %></td><td><%= city.display_name %></td><td><%= city.name %></td><td><%= city.width %> × <%= city.height %></td>
        <td class="nl-manage-table-actions"><%= link_to t("manage.view"), manage_city_path(city) %> <%= link_to t("manage.edit"), edit_manage_city_path(city) %></td></tr>
    <% end %>
    <% if @cities.empty? %><tr><td colspan="6" class="nl-manage-empty"><%= t("manage.views.empty_city_nodes") %></td></tr><% end %>
  </tbody>
</table></div>
<%= render "manage/shared/pagination", pagination: @pagination %>
