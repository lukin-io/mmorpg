<%= render "manage/shared/page_header", title: @city.display_name, description: @city.name %>
<table class="nl-sheet-table nl-manage-detail">
  <tr><th><%= t("manage.views.col_city_key") %></th><td><%= @city.metadata.to_h["city_key"].presence || "—" %></td></tr><tr><th><%= t("manage.views.col_node_key") %></th><td><%= @city.city_node_key.presence || "—" %></td></tr>
  <tr><th><%= t("manage.views.col_grid_size") %></th><td><%= @city.width %> × <%= @city.height %></td></tr><tr><th><%= t("manage.views.col_active_actions") %></th><td><%= @city.city_hotspots.active.count %></td></tr>
</table>
<h2 class="invtitle"><%= t("manage.views.city_data") %></h2><pre class="nl-manage-json"><%= pretty_json(@city.metadata) %></pre>
<%= render "manage/shared/record_actions", edit_path: edit_manage_city_path(@city), delete_path: manage_city_path(@city), back_path: manage_cities_path %>
