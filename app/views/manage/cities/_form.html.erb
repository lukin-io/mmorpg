<%= render "manage/shared/errors", record: city %>
<%= form_with model: city, url:, class: "nl-manage-form" do |form| %>
  <div class="nl-manage-field-grid">
    <div class="nl-manage-field"><%= form.label :name, "Zone name" %><%= form.text_field :name, required: true %></div>
    <div class="nl-manage-field"><span>Location type</span><strong>city</strong></div>
    <div class="nl-manage-field"><%= form.label :width %><%= form.number_field :width, min: 1, required: true %></div>
    <div class="nl-manage-field"><%= form.label :height %><%= form.number_field :height, min: 1, required: true %></div>
    <div class="nl-manage-field nl-manage-field--wide">
      <%= form.label :metadata, "City data (JSON)" %><%= form.text_area :metadata, value: pretty_json(city.metadata), spellcheck: false %>
      <small class="nl-manage-help">Stable keys live in <code>city_key</code> and <code>city_node_key</code>. Scene presentation uses <code>city_presentation</code> with image offset, focus, and optional landmarks.</small>
    </div>
  </div>
  <%= render "manage/shared/form_actions", form:, submit_label:, cancel_path: %>
<% end %>
