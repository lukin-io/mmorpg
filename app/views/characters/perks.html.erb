<% content_for :title, "Perks - #{@character.name}" %>

<section class="nl-allocation-page nl-source-character-page">
  <div class="nl-source-character-grid">
    <aside class="nl-source-character-left">
      <%= render "shared/neverlands_character_sheet",
        character: @character,
        equipment: @equipment,
        interactive: false,
        show_money: true %>
    </aside>

    <main class="nl-source-character-right">
      <%= render "shared/neverlands_profile_navigation", character: @character, current_section: :perks %>
      <turbo-frame id="perk-allocation" class="nl-source-allocation nl-source-allocation--page">
        <%= render "characters/perk_allocation" %>
      </turbo-frame>
    </main>
  </div>
</section>
