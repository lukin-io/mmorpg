<div class="login-container">
  <h1><%= t("auth.sign_up") %></h1>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="field">
      <%= f.label :profile_name, t("auth.nickname") %>
      <%= f.text_field :profile_name,
            autofocus: true,
            autocomplete: "username",
            maxlength: User::MAX_PROFILE_NAME_LENGTH,
            required: true,
            placeholder: t("auth.nickname_placeholder") %>
      <p class="text-muted text-sm"><%= t("auth.nickname_hint") %></p>
    </div>

    <div class="field">
      <%= f.label :email, t("auth.email") %>
      <%= f.email_field :email, autocomplete: "email" %>
    </div>

    <div class="field">
      <%= f.label :password, t("auth.password") %>
      <% if @minimum_password_length %>
        <span class="text-muted text-sm">(<%= t("auth.password_min", count: @minimum_password_length) %>)</span>
      <% end %>
      <%= f.password_field :password, autocomplete: "new-password" %>
    </div>

    <div class="field">
      <%= f.label :password_confirmation, t("auth.password_confirmation") %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
    </div>

    <div class="field">
      <%= f.submit t("auth.create_account"), class: "btn-primary w-full" %>
    </div>
  <% end %>

  <hr>

  <div class="text-center">
    <%= link_to t("auth.already_have_account"), new_session_path(resource_name) %>
  </div>
</div>
