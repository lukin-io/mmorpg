<div class="login-container">
  <h1><%= t("auth.forgot_title") %></h1>
  <p class="text-muted"><%= t("auth.forgot_hint") %></p>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="field">
      <%= f.label :email, t("auth.email") %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email" %>
    </div>

    <div class="field">
      <%= f.submit t("auth.send_reset"), class: "btn-primary w-full" %>
    </div>
  <% end %>

  <hr>

  <div class="text-center">
    <%= link_to t("auth.back_to_login"), new_session_path(resource_name) %>
  </div>
</div>
