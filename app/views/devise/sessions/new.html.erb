<div class="login-container">
  <h1><%= t("auth.sign_in") %></h1>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: {data: {turbo: false}}) do |f| %>
    <div class="field">
      <%= f.label :email, t("auth.email") %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email" %>
    </div>

    <div class="field">
      <%= f.label :password, t("auth.password") %>
      <%= f.password_field :password, autocomplete: "current-password" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="field">
        <%= f.check_box :remember_me %>
        <%= f.label :remember_me, t("auth.remember_me") %>
      </div>
    <% end %>

    <div class="field">
      <%= f.submit t("auth.enter"), class: "btn-primary w-full" %>
    </div>
  <% end %>

  <hr>

  <div class="text-center">
    <%= link_to t("auth.forgot_password"), new_password_path(resource_name) %>
    <br>
    <%= link_to t("auth.create_character"), new_registration_path(resource_name) %>
  </div>
</div>
