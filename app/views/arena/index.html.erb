<% content_for :title, t("arena.title") %>

<% active_tab = (params[:ft].presence || "1").to_s %>
<% total_applications = @rooms.sum(&:open_application_count) %>

<div class="nl-arena-frame"
     data-controller="arena"
     data-arena-character-level-value="<%= current_character.level %>"
     data-arena-copy-value="<%= {
       room_level: t("arena.client.room_level"),
       submit_failed: t("arena.client.submit_failed"),
       accept_failed: t("arena.client.accept_failed"),
       cancel_failed: t("arena.client.cancel_failed"),
       network_error: t("arena.client.network_error"),
       choose_fight_kind: t("arena.client.choose_fight_kind"),
       choose_timeout: t("arena.client.choose_timeout"),
       fight_started: t("arena.client.fight_started"),
       cancel_confirm: t("arena.cancel_confirm")
     }.to_json %>"
     data-arena-apps="<%= total_applications %>"
     data-arena-has-application="<%= @current_application.present? ? "1" : "0" %>">
  <div class="nl-arena-topline">
    <div class="nl-arena-character">
      <%= current_character.name %>[<%= current_character.level %>]
      <span class="nl-arena-vitals"
            data-arena-vitals="1"
            data-arena-hp="<%= current_character.current_hp %>"
            data-arena-max-hp="<%= current_character.max_hp %>"
            data-arena-mp="<%= current_character.current_mp %>"
            data-arena-max-mp="<%= current_character.max_mp %>"><%= current_character.current_hp %>/<%= current_character.max_hp %> | <%= current_character.current_mp %>/<%= current_character.max_mp %></span>
    </div>
    <div class="nl-arena-controls">
      <%= link_to t("arena.nav.character"), player_path(name: current_character.name), class: "nl-arena-link", data: {arena_recovery: "character"} %>
      <%= link_to t("arena.nav.inventory"), inventory_path, class: "nl-arena-link", data: {arena_recovery: "inventory"} %>
      <span class="nl-arena-link nl-arena-link--current"><%= t("arena.nav.arena") %></span>
      <%= link_to t("arena.nav.city"), world_path, class: "nl-arena-link", data: {turbo: false, arena_recovery: "city"} %>
    </div>
  </div>

  <div class="nl-arena-status-row">
    <span><%= t("arena.applications") %>: <%= link_to t("arena.your_level"), arena_index_path(ft: active_tab, level: current_character.level), class: "nl-arena-filter" %> | <%= link_to t("arena.all"), arena_index_path(ft: active_tab), class: "nl-arena-filter" %></span>
    <span><%= t("arena.total") %>: <b><%= total_applications %></b></span>
    <%= link_to t("arena.refresh"), arena_index_path(ft: active_tab), class: "nl-arena-link" %>
    <button type="button" class="nl-arena-link nl-arena-link--button" data-action="click->arena#showRooms"><%= t("arena.room_map") %></button>
  </div>
  <% if total_applications.zero? %>
    <p class="nl-quests-board__meta" data-arena-apps-empty="1">
      <%= t("arena.apps_empty") %>
      ·
      <%= link_to t("arena.nav.city"), world_path, class: "nl-sheet-link", data: {turbo: false, arena_recovery: "city"} %>
    </p>
  <% end %>
  <% if params[:arena_denied].to_s == "1" %>
    <p class="nl-quests-board__meta" data-arena-denied="1">
      <%= t("arena.denied_next") %>
      ·
      <%= link_to t("arena.nav.city"), world_path, class: "nl-sheet-link", data: {turbo: false, arena_recovery: "city"} %>
      ·
      <%= link_to t("arena.tabs.duels"), arena_index_path(ft: 1), class: "nl-sheet-link", data: {arena_recovery: "duels"} %>
    </p>
  <% end %>
  <% if params[:application_denied].to_s == "1" %>
    <p class="nl-quests-board__meta" data-application-denied="1">
      <%= t("arena.application_denied_next") %>
      ·
      <%= link_to t("arena.tabs.duels"), arena_index_path(ft: 1), class: "nl-sheet-link", data: {application_recovery: "lobby"} %>
      ·
      <%= link_to t("arena.nav.city"), world_path, class: "nl-sheet-link", data: {turbo: false, application_recovery: "city"} %>
    </p>
  <% end %>

  <div class="nl-arena-tabs">
    <%= link_to t("arena.tabs.duels"), arena_index_path(ft: 1), class: "nl-arena-tab #{'nl-arena-tab--active' if active_tab == '1'}" %>
    <%= link_to t("arena.tabs.team_battles"), arena_index_path(ft: 2), class: "nl-arena-tab #{'nl-arena-tab--active' if active_tab == '2'}" %>
    <%= link_to t("arena.tabs.sacrifice"), arena_index_path(ft: 3), class: "nl-arena-tab #{'nl-arena-tab--active' if active_tab == '3'}" %>
    <%= link_to t("arena.tabs.statistics"), arena_index_path(ft: 4), class: "nl-arena-tab #{'nl-arena-tab--active' if active_tab == '4'}" %>
  </div>

  <% if @current_application %>
    <div class="nl-arena-current-row">
      <b><%= t("arena.your_application") %>:</b>
      <%= fight_type_label(@current_application.fight_type) %>,
      <%= fight_kind_label(@current_application.fight_kind) %>,
      <%= t("arena.timeout_min", count: @current_application.timeout_seconds / 60) %>,
      <%= t("arena.trauma", percent: @current_application.trauma_percent) %>,
      <%= t("arena.room", name: @current_application.arena_room.name) %>.
      <%= button_to t("arena.cancel_application"),
          cancel_arena_application_path(@current_application),
          method: :delete,
          class: "nl-arena-small-button",
          data: { turbo_confirm: t("arena.cancel_confirm") } %>
    </div>
  <% end %>

  <div class="nl-arena-room-scheme" data-arena-target="roomGrid">
    <table class="nl-arena-table nl-arena-rooms-table">
      <% @rooms.each_slice(5) do |row| %>
        <tr>
          <% row.each do |room| %>
            <% accessible = room.accessible_by?(current_character) %>
            <td class="nl-arena-room-cell <%= accessible ? 'nl-arena-room-cell--open' : 'nl-arena-room-cell--locked' %>"
                data-arena-room="<%= room.id %>"
                data-arena-room-accessible="<%= accessible ? "1" : "0" %>"
                data-arena-room-apps="<%= room.open_application_count %>">
              <b><%= room_type_badge(room.room_type) %></b> [ <%= room.open_application_count %> ]<br>
              <span><%= room.level_min %>-<%= room.level_max %></span><br>
              <% if accessible %>
                <%= link_to t("arena.enter"), arena_room_path(room), class: "nl-arena-small-button", data: {turbo_frame: "_top"} %>
              <% else %>
                <span class="nl-arena-muted" data-arena-room-locked="1">
                  <%= t("arena.unavailable") %>
                  ·
                  <%= t("arena.room_locked_hint") %>
                  ·
                  <%= link_to t("arena.nav.city"), world_path, class: "nl-sheet-link", data: {turbo: false, arena_recovery: "city"} %>
                </span>
              <% end %>
            </td>
          <% end %>
        </tr>
      <% end %>
    </table>
  </div>

  <% if active_tab == "4" %>
    <div class="nl-arena-search" data-arena-stats-tab="1">
      <b><%= t("arena.statistics_title") %></b>
      <span class="nl-arena-muted"><%= t("arena.statistics_hint") %></span>
      <p class="nl-quests-board__meta">
        <%= t("arena.statistics_next") %>
        ·
        <%= link_to t("arena.tabs.duels"), arena_index_path(ft: 1), class: "nl-sheet-link", data: {arena_recovery: "duels"} %>
        ·
        <%= link_to t("arena.nav.city"), world_path, class: "nl-sheet-link", data: {turbo: false, arena_recovery: "city"} %>
      </p>
    </div>
  <% else %>
    <table class="nl-arena-table nl-arena-summary-table">
      <thead>
        <tr>
          <th><%= t("arena.columns.room") %></th>
          <th><%= t("arena.columns.levels") %></th>
          <th><%= t("arena.columns.applications") %></th>
          <th><%= t("arena.columns.fights") %></th>
          <th><%= t("arena.columns.action") %></th>
        </tr>
      </thead>
      <tbody>
        <% @rooms.each do |room| %>
          <% accessible = room.accessible_by?(current_character) %>
          <tr class="<%= accessible ? '' : 'nl-arena-row--locked' %>"
              data-arena-room-row="<%= room.id %>"
              data-arena-room-accessible="<%= accessible ? "1" : "0" %>">
            <td><%= room_type_badge(room.room_type) %></td>
            <td><%= room.level_min %>-<%= room.level_max %></td>
            <td data-arena-room-apps="<%= room.open_application_count %>"><%= room.open_application_count %></td>
            <td data-arena-room-fights="<%= room.current_match_count %>"><%= room.current_match_count %></td>
            <td>
              <% if accessible %>
                <%= link_to t("arena.enter"), arena_room_path(room), class: "nl-arena-small-button", data: {turbo_frame: "_top"} %>
              <% else %>
                <span class="nl-arena-muted" data-arena-row-locked="1">
                  <%= t("arena.level_mismatch") %>
                  ·
                  <%= t("arena.room_locked_hint") %>
                </span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>

  <% if @recent_matches.any? %>
    <div class="nl-arena-recent">
      <b><%= t("arena.recent_fights") %></b>
      <% @recent_matches.each do |participation| %>
        <% match = participation.arena_match %>
        <div class="nl-arena-recent-row">
          <%= fight_type_label(match.match_type) %> —
          <%= t("arena.results.#{participation.result}", default: participation.result.to_s.tr("_", " ")) %>,
          <%= t("arena.ago", time: time_ago_in_words(match.created_at)) %>.
          <%= link_to t("arena.log"), public_fight_log_path(match), class: "nl-arena-filter" %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="nl-arena-recent" data-arena-recent-empty="1">
      <b><%= t("arena.recent_fights") %></b>
      <p class="nl-quests-board__meta">
        <%= t("arena.recent_empty") %>
        ·
        <%= link_to t("arena.tabs.duels"), arena_index_path(ft: 1), class: "nl-sheet-link", data: {arena_recovery: "duels"} %>
      </p>
    </div>
  <% end %>
</div>

<div class="arena-countdown" data-arena-target="countdown" hidden>
  <div class="arena-countdown-title"><%= t("arena.fight_starting") %></div>
  <div class="arena-countdown-timer">--</div>
</div>
