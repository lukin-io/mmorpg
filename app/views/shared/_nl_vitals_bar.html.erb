<%#
  Inline HP/MP Bar (matches original layout)
  Shows: [red HP bar][values text]

  Usage: render the shared nl_vitals_bar partial with a character local.
%>

<% character ||= current_character %>
<%
  max_hp = character.effective_max_hp
  max_mp = character.effective_max_mp
  hp_percent = max_hp.zero? ? 0 : ((character.current_hp.to_f / max_hp) * 100).round
  mp_percent = max_mp.zero? ? 0 : ((character.current_mp.to_f / max_mp) * 100).round
%>

<div class="nl-vitals-inline"
     data-controller="nl-vitals"
     data-nl-vitals-current-hp-value="<%= character.current_hp %>"
     data-nl-vitals-max-hp-value="<%= max_hp %>"
     data-nl-vitals-current-mp-value="<%= character.current_mp %>"
     data-nl-vitals-max-mp-value="<%= max_mp %>"
     data-nl-vitals-sync-url-value="<%= character_vitals_path if character.id == current_character&.id %>">

  <%# Source bar stack: HP above MP in the same 160px strip. %>
  <div class="nl-vitals-bars">
    <div class="nl-hp-bar-inline" data-nl-vitals-target="hpBar">
      <div class="nl-bar-fill" style="width: <%= hp_percent %>%;" data-nl-vitals-target="hpFill"></div>
    </div>
    <div class="nl-mp-bar-inline" data-nl-vitals-target="mpBar">
      <div class="nl-bar-fill" style="width: <%= mp_percent %>%;" data-nl-vitals-target="mpFill"></div>
    </div>
  </div>

  <%#
    Source readout: `[curHP/maxHP | curMP/maxMP]` in `.hpfont`, with the HP pair
    in the combat color and the MP pair in the link color.
  %>
  <span class="nl-vitals-text">[<span
    class="nl-vitals-hp" data-nl-vitals-target="hpText"><%= character.current_hp.round %>/<%= max_hp %></span> | <span
    class="nl-vitals-mp" data-nl-vitals-target="mpText"><%= character.current_mp.round %>/<%= max_mp %></span>]</span>
</div>
