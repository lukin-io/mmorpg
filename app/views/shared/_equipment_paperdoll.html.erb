<%#
  Shared equipment paper doll.

  Reproduces the live Neverlands doll geometry (see
  doc/design/reference/neverlands_live_style_system.md): a 62px left rail, a
  center portrait with a four-ring row and a three-slot belt-content row, and a
  62px right rail whose first line pairs the pocket with its content.

  Read-only on the player profile (source `slots_pla`); interactive unequip on
  the inventory page (source `slots_inv`).

  Locals:
    character     - Character whose doll is shown
    equipment     - Hash of slot key (sym or str) => InventoryItem
    interactive   - when true, filled slots render a server-authorized remove action
    portrait_html - optional portrait markup rendered in the center
%>
<% character ||= nil %>
<% equipment ||= {} %>
<% interactive = local_assigns.fetch(:interactive, false) %>
<% slot_locals = {
     equipment: equipment,
     interactive: interactive,
     category: local_assigns[:category],
     subcategory: local_assigns[:subcategory],
     info_mode: local_assigns[:info_mode]
   } %>

<div class="nl-doll">
  <div class="nl-doll-rail nl-doll-rail--left">
    <% EquipmentSlots::LEFT.each do |slot| %>
      <%= render "shared/equipment_paperdoll_slot", slot_locals.merge(slot: slot) %>
    <% end %>
  </div>

  <div class="nl-doll-center">
    <div class="nl-doll-portrait">
      <% if local_assigns[:portrait_html].present? %>
        <%= local_assigns[:portrait_html] %>
      <% elsif character %>
        <span class="nl-doll-figure" role="img" aria-label="<%= character.name %>">
          <span class="nl-doll-figure-head" aria-hidden="true"></span>
          <span class="nl-doll-figure-body" aria-hidden="true"></span>
          <span class="nl-doll-figure-arm nl-doll-figure-arm--left" aria-hidden="true"></span>
          <span class="nl-doll-figure-arm nl-doll-figure-arm--right" aria-hidden="true"></span>
          <span class="nl-doll-figure-leg nl-doll-figure-leg--left" aria-hidden="true"></span>
          <span class="nl-doll-figure-leg nl-doll-figure-leg--right" aria-hidden="true"></span>
        </span>
      <% end %>
    </div>

    <div class="nl-doll-rings">
      <% EquipmentSlots::RINGS.each do |slot| %>
        <%= render "shared/equipment_paperdoll_slot", slot_locals.merge(slot: slot) %>
      <% end %>
    </div>

    <div class="nl-doll-belt-content">
      <% EquipmentSlots::BELT_CONTENT.each do |slot| %>
        <%= render "shared/equipment_paperdoll_slot", slot_locals.merge(slot: slot) %>
      <% end %>
    </div>
  </div>

  <div class="nl-doll-rail nl-doll-rail--right">
    <div class="nl-doll-pocket-row">
      <% EquipmentSlots::POCKET_ROW.each do |slot| %>
        <%= render "shared/equipment_paperdoll_slot", slot_locals.merge(slot: slot) %>
      <% end %>
    </div>
    <% EquipmentSlots::RIGHT.each do |slot| %>
      <%= render "shared/equipment_paperdoll_slot", slot_locals.merge(slot: slot) %>
    <% end %>
  </div>
</div>
