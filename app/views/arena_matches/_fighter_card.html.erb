<%#
  Fighter card for a Neverlands-style arena fight
  Shows player/NPC with HP bar, stats, and status

  Required locals:
  - participation: ArenaParticipation record
  - show_stats: Boolean, whether to show opponent stats
  - position: :left or :right (for styling)
%>
<% p_data = participant_data(participation) %>
<% defeated = p_data.current_hp <= 0 %>
<% selected_target = local_assigns.fetch(:selected_target, false) %>
<% fighter_equipment = arena_fighter_equipment(participation) %>
<% npc_portrait = if participation.npc?
  participation_avatar_tag(participation, size: :xlarge, class: "nl-fight-npc-portrait")
end %>

<div class="fighter-card fighter-card--<%= position %> <%= 'fighter-card--defeated' if defeated %> <%= 'fighter-card--npc' if p_data.is_npc %> <%= 'fighter-card--selected-target' if selected_target %>"
     data-character-id="<%= p_data.id %>"
     data-character-name="<%= p_data.name %>"
     data-current-hp="<%= p_data.current_hp %>"
     data-max-hp="<%= p_data.max_hp %>"
     data-team="<%= participation.team %>"
     data-npc="<%= p_data.is_npc %>"
     data-current-user="<%= !p_data.is_npc && participation.user_id == current_user&.id %>">

  <%# Name and Level %>
  <div class="fighter-header">
    <span class="fighter-name <%= 'fighter-name--defeated' if defeated %>">
      <%= p_data.name %>
    </span>
    <span class="fighter-level">[<%= p_data.level %>]</span>
    <% if p_data.is_npc %>
      <span class="fighter-badge fighter-badge--npc"><%= t("game.fight.npc") %></span>
    <% end %>
  </div>

  <%# HP Bar %>
  <div class="fighter-hp">
    <div class="fighter-hp-bar" title="<%= t("game.fight.hp_title", current: p_data.current_hp, max: p_data.max_hp) %>">
      <div class="fighter-hp-fill fighter-hp-fill--<%= hp_color_class(p_data.hp_percent) %>"
           style="width: <%= p_data.hp_percent %>%"></div>
      <span class="fighter-hp-text"><%= p_data.current_hp %>/<%= p_data.max_hp %></span>
    </div>
    <span class="fighter-hp-percent"><%= p_data.hp_percent.round %>%</span>
  </div>

  <%# MP Bar (players only) %>
  <% unless p_data.is_npc %>
    <div class="fighter-mp">
      <div class="fighter-mp-bar" title="<%= t("game.fight.mp_title", current: p_data.current_mp, max: p_data.max_mp) %>">
        <div class="fighter-mp-fill" style="width: <%= p_data.mp_percent %>%"></div>
        <span class="fighter-mp-text"><%= p_data.current_mp %>/<%= p_data.max_mp %></span>
      </div>
    </div>
  <% end %>

  <%# Source fight composition: equipment slots surround the portrait. %>
  <div class="fighter-paperdoll">
    <%= render "shared/equipment_paperdoll",
      character: participation.character,
      equipment: fighter_equipment,
      interactive: false,
      portrait_html: npc_portrait %>
    <% if defeated %>
      <div class="fighter-defeated-overlay"><%= t("game.fight.defeated") %></div>
    <% end %>
  </div>

  <div class="fighter-combat-power">
    <span class="fighter-power" title="<%= t("game.fight.attack_power_hint") %>">
      <%= t("game.fight.attack_power") %> <%= p_data.attack_power %>
    </span>
    <span class="fighter-power" title="<%= t("game.fight.defense_hint") %>">
      <%= t("game.fight.defense") %> <%= p_data.defense %>
    </span>
  </div>

  <%# Stats (shown for opponent) %>
  <% if show_stats %>
    <div class="fighter-stats fighter-stats--nl">
      <div><%= t("game.stats.strength") %>: <b><%= p_data.strength %></b></div>
      <div><%= t("game.stats.dexterity") %>: <b><%= p_data.dexterity %></b></div>
      <div><%= t("game.stats.luck") %>: <b><%= p_data.luck %></b></div>
      <div><%= t("game.stats.knowledge") %>: <b><%= p_data.knowledge %></b></div>
      <div><%= t("game.sheet.armor_class") %>: <b><%= p_data.armor_class %></b></div>
      <div><%= t("game.sheet.dodge") %>: <b><%= p_data.evasion %></b></div>
      <div><%= t("game.sheet.accuracy") %>: <b><%= p_data.accuracy %></b></div>
      <div><%= t("game.sheet.crushing") %>: <b><%= p_data.crushing %></b></div>
      <div><%= t("game.sheet.fortitude") %>: <b><%= p_data.endurance %></b></div>
      <div><%= t("game.sheet.armor_pierce") %>: <b><%= p_data.armor_penetration %></b></div>
    </div>
  <% end %>

  <%# Result badge (if match completed) %>
  <% if participation.result.present? && participation.result != "pending" %>
    <div class="fighter-result fighter-result--<%= participation.result %>">
      <%= { "victory" => t("arena.results.victory"), "defeat" => t("arena.results.defeat"), "draw" => t("arena.results.draw") }.fetch(participation.result, participation.result) %>
    </div>
  <% end %>
</div>
