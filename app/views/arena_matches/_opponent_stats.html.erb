<%#
  Displays opponent's combat-relevant stats
  Shows: Strength, Dexterity, Luck, and Knowledge

  Required locals:
  - participation: ArenaParticipation record
%>
<% stats = opponent_combat_stats(participation) %>

<% if stats.present? %>
  <div class="arena-opponent-stats">
    <dl class="stats-grid stats-grid--compact">
      <div class="stat-item" title="<%= t("game.fight.str_hint") %>">
        <dt><%= t("game.fight.str_short") %></dt>
        <dd><%= stats[:strength] || stats[:attack] || "-" %></dd>
      </div>
      <div class="stat-item" title="<%= t("game.fight.dex_hint") %>">
        <dt><%= t("game.fight.dex_short") %></dt>
        <dd><%= stats[:dexterity] || stats[:agility] || "-" %></dd>
      </div>
      <div class="stat-item" title="<%= t("game.fight.luck_hint") %>">
        <dt><%= t("game.fight.luck_short") %></dt>
        <dd><%= stats[:luck] || "-" %></dd>
      </div>
      <div class="stat-item" title="<%= t("game.fight.int_hint") %>">
        <dt><%= t("game.fight.int_short") %></dt>
        <dd><%= stats[:knowledge] || stats[:intelligence] || "-" %></dd>
      </div>
    </dl>
  </div>
<% end %>
