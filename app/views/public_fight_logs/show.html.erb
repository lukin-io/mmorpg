<% content_for :title, t("game.fight.log_page_title", id: @arena_match.id) %>
<% content_for :body_class, "nl-public-layout--fight-log" %>

<section class="combat-log-viewer nl-public-fight-log">
  <h1 class="nl-visually-hidden"><%= t("game.fight.log_page_title", id: @arena_match.id) %></h1>

  <nav class="fight-log-modes" aria-label="<%= t("game.fight.log") %>">
    <% if @view_mode == :log %>
      <span aria-current="page"><%= t("game.fight.log") %></span>
    <% else %>
      <%= link_to t("game.fight.log"), public_fight_log_path(@arena_match) %>
    <% end %>
    <% if @view_mode == :statistics %>
      <span aria-current="page"><%= t("game.fight.statistics") %></span>
    <% else %>
      <%= link_to t("game.fight.statistics"), public_fight_log_path(@arena_match, stat: 1) %>
    <% end %>
  </nav>

  <% if @view_mode == :statistics %>
    <% part_labels = {"head" => t("game.fight.head"), "torso" => t("game.fight.torso"), "stomach" => t("game.fight.abdomen"), "legs" => t("game.fight.legs")} %>
    <div class="combat-log-content">
      <table class="nl-detail-table nl-fight-stat-table">
        <thead>
          <tr>
            <th><%= t("game.fight.participant") %></th>
            <th><%= t("game.fight.side") %></th>
            <th><%= t("game.fight.damage") %></th>
            <th><%= t("game.fight.hits") %></th>
          </tr>
        </thead>
        <tbody>
          <% @statistics.by_participant.each do |row| %>
            <tr>
              <td><%= row[:name] %></td>
              <td><%= row[:team] %></td>
              <td><%= row[:total_damage] %></td>
              <td><%= row[:total_hits] %></td>
            </tr>
          <% end %>
        </tbody>
      </table>

      <table class="nl-detail-table nl-fight-stat-table">
        <thead>
          <tr>
            <th><%= t("game.fight.zone") %></th>
            <th><%= t("game.fight.attacks") %></th>
            <th><%= t("game.fight.damage") %></th>
            <th><%= t("game.fight.blocks") %></th>
          </tr>
        </thead>
        <tbody>
          <% @statistics.body_part_breakdown.each do |part, row| %>
            <tr>
              <td><%= part_labels.fetch(part.to_s, part.to_s) %></td>
              <td><%= row[:attacks] %></td>
              <td><%= row[:damage] %></td>
              <td><%= row[:blocked] %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="combat-log-content">
      <div class="log-entries">
        <% if @combat_log_entries.any? %>
          <% @combat_log_entries.group_by(&:round_number).each do |round, entries| %>
            <div class="round-group" data-round="<%= round %>">
              <% entries.each do |entry| %>
                <div class="log-entry log-type-<%= entry.log_type %>" data-log-id="<%= entry.id %>">
                  <div class="entry-header">
                    <span class="entry-time"><%= entry.occurred_at_or_created_at.strftime("%H:%M:%S") %></span>
                  </div>
                  <div class="entry-content">
                    <span class="raw-message"><%= public_fight_log_message(entry, team_a: @team_a, team_b: @team_b) %></span>
                    <% if entry.damage_amount.positive? %>
                      <span class="damage"><%= entry.damage_amount %> <%= t("game.fight.damage").downcase %></span>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>
        <% else %>
          <p class="fight-log-empty" role="status" data-fight-log-empty="1">
            <%= t("game.fight.no_events") %>
            ·
            <%= link_to t("arena.nav.arena"), arena_index_path, class: "nl-sheet-link", data: {fight_log_recovery: "arena"} %>
            ·
            <%= link_to t("arena.nav.city"), world_path, class: "nl-sheet-link", data: {fight_log_recovery: "city"} %>
          </p>
        <% end %>
      </div>

    </div>
  <% end %>

  <div class="fight-participants">
    <span class="participants-label"><%= t("game.fight.participants") %>:</span>
    <span class="team team-alpha">
      <% @team_a.each_with_index do |participant, index| %>
        <span class="participant nl-log-name--alpha <%= participant.current_hp.positive? ? 'alive' : 'dead' %>">
          <%= participant.participant_name %>[<%= participant.participant_level %>]
          <span class="vitals">[<%= participant.current_hp %>/<%= participant.max_hp %>]</span>
        </span><%= index < @team_a.length - 1 ? ", " : "" %>
      <% end %>
    </span>
    <span class="vs"><%= t("game.fight.against") %></span>
    <span class="team team-beta">
      <% @team_b.each_with_index do |participant, index| %>
        <span class="participant nl-log-name--beta <%= participant.current_hp.positive? ? 'alive' : 'dead' %>">
          <%= participant.participant_name %>[<%= participant.participant_level %>]
          <span class="vitals">[<%= participant.current_hp %>/<%= participant.max_hp %>]</span>
        </span><%= index < @team_b.length - 1 ? ", " : "" %>
      <% end %>
    </span>
  </div>

  <% if @view_mode == :log && @total_pages && @total_pages > 1 %>
    <nav class="log-pagination" aria-label="<%= t("game.fight.log") %> pages">
      <span class="page-label"><%= t("game.fight.pages") %>:</span>
      <% (1..@total_pages).each do |page| %>
        <% if page == @page %>
          <span class="current-page"><%= page %></span>
        <% else %>
          <%= link_to page, public_fight_log_path(@arena_match, p: page), class: "page-link" %>
        <% end %>
      <% end %>
    </nav>
  <% end %>
</section>
