<% content_for :title, "#{@chat_channel.name} - Chat" %>
<% content_for :hide_shell_chat_composer, true %>
<% content_for :hide_shell_chat_history, true %>

<%# Subscribe to real-time updates via ActionCable/Turbo Streams %>
<% unless @chat_channel.local? || @chat_channel.global? %>
  <%= turbo_stream_from @chat_channel %>
<% end %>
<% if @chat_channel.global? || @chat_channel.local? %>
  <%= turbo_stream_from Chat::TimelineBroadcaster::GLOBAL_STREAM %>
  <%= turbo_stream_from Chat::TimelineBroadcaster::PERSONAL_STREAM, current_user %>
<% end %>

<section class="chat-channel-page"
         data-controller="chat"
         data-chat-auto-scroll-value="true"
         <% if @chat_channel.local? %>
           data-chat-poll-url-value="<%= local_chat_path(poll: 1) %>"
           data-chat-session-key-value="<%= @chat_session_key %>"
           data-chat-context-key-value="<%= @chat_context.key %>"
         <% end %>
         data-chat-current-user-value="<%= current_user.profile_name %>">
  <div class="chat-header">
    <div class="chat-header-info">
      <h1><%= @chat_channel.name %></h1>
      <span class="badge badge--<%= @chat_channel.channel_type %>"><%= @chat_channel.channel_type.humanize %></span>
    </div>
  </div>

  <div class="chat-container">
    <%# Messages area %>
    <div id="<%= chat_timeline_dom_id %>"
         data-chat-target="messages"
         role="log"
         aria-live="polite"
         class="chat-messages-container">

      <% if @chat_entries.empty? %>
        <div class="chat-empty">
          <p>No messages yet.</p>
        </div>
      <% else %>
        <%= render "chat_channels/timeline_entries", entries: @chat_entries %>
      <% end %>
    </div>

    <%# New message indicator (shown when scrolled up) %>
    <button class="new-message-indicator" data-action="click->chat#jumpToBottom">
      v New messages
    </button>

    <%# Message input form %>
    <% if ChatMessagePolicy.new(current_user, @chat_channel).create? %>
      <div id="<%= dom_id(@chat_channel, :form) %>" class="chat-input-area">
        <%= render "chat_messages/form", chat_channel: @chat_channel, chat_message: @chat_message %>
      </div>
    <% end %>
  </div>

  <div class="user-menu" data-chat-target="userMenu"></div>
</section>
