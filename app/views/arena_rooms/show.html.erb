<% content_for :title, "#{@room.name} — #{t("arena.title")}" %>

<%
  active_tab = (params[:ft].presence || "1").to_s
  tab_fight_type = {"1" => "duel", "2" => "team_battle", "3" => "sacrifice"}[active_tab] || "duel"
  visible_applications = @applications.select { |app| app.fight_type == tab_fight_type }
%>

<div class="nl-arena-frame"
     data-controller="arena"
     data-arena-room-id-value="<%= @room.id %>"
     data-arena-character-id-value="<%= current_character.id %>"
     data-arena-character-level-value="<%= current_character.level %>"
     data-arena-copy-value="<%= {
       room_level: t("arena.client.room_level"),
       submit_failed: t("arena.client.submit_failed"),
       accept_failed: t("arena.client.accept_failed"),
       cancel_failed: t("arena.client.cancel_failed"),
       network_error: t("arena.client.network_error"),
       choose_fight_kind: t("arena.client.choose_fight_kind"),
       choose_timeout: t("arena.client.choose_timeout"),
       fight_started: t("arena.client.fight_started"),
       cancel_confirm: t("arena.cancel_confirm")
     }.to_json %>">
  <div class="nl-arena-topline">
    <div class="nl-arena-character">
      <%= current_character.name %>[<%= current_character.level %>]
      <span class="nl-arena-vitals"><%= current_character.current_hp %>/<%= current_character.max_hp %> | <%= current_character.current_mp %>/<%= current_character.max_mp %></span>
    </div>
    <div class="nl-arena-controls">
      <%= link_to t("arena.nav.character"), player_path(name: current_character.name), class: "nl-arena-link", data: {arena_recovery: "character"} %>
      <%= link_to t("arena.nav.inventory"), inventory_path, class: "nl-arena-link", data: {arena_recovery: "inventory"} %>
      <%= link_to t("arena.nav.arena"), arena_index_path, class: "nl-arena-link", data: {arena_recovery: "lobby"} %>
      <%= link_to t("arena.nav.city"), world_path, class: "nl-arena-link", data: {turbo: false, arena_recovery: "city"} %>
    </div>
  </div>

  <% if params[:application_denied].to_s == "1" %>
    <p class="nl-quests-board__meta" data-application-denied="1">
      <%= t("arena.application_denied_next") %>
      ·
      <%= link_to t("arena.nav.arena"), arena_index_path, class: "nl-arena-link", data: {application_recovery: "lobby"} %>
      ·
      <%= link_to t("arena.nav.city"), world_path, class: "nl-arena-link", data: {turbo: false, application_recovery: "city"} %>
    </p>
  <% end %>

  <div class="nl-arena-room-heading">
    <b><%= @room.name %></b>
    <span><%= t("arena.levels", min: @room.level_min, max: @room.level_max) %></span>
    <% if @room.alignment_restriction.present? %>
      <span><%= t("game.buildings.law_alignment.#{@room.alignment_restriction}", default: @room.alignment_restriction.to_s.tr("_", " ")) %></span>
    <% end %>
  </div>

  <div class="nl-arena-status-row">
    <span><%= t("arena.applications") %>: <%= link_to t("arena.your_level"), arena_room_path(@room, ft: active_tab, level: current_character.level), class: "nl-arena-filter" %> | <%= link_to t("arena.all"), arena_room_path(@room, ft: active_tab), class: "nl-arena-filter" %></span>
    <span><%= t("arena.total") %>: <b><%= visible_applications.size %></b></span>
    <%= link_to t("arena.refresh"), arena_room_path(@room, ft: active_tab), class: "nl-arena-link" %>
    <%= link_to t("arena.room_map"), arena_index_path, class: "nl-arena-link" %>
  </div>

  <div class="nl-arena-tabs">
    <%= link_to t("arena.tabs.duels"), arena_room_path(@room, ft: 1), class: "nl-arena-tab #{'nl-arena-tab--active' if active_tab == '1'}" %>
    <%= link_to t("arena.tabs.team_battles"), arena_room_path(@room, ft: 2), class: "nl-arena-tab #{'nl-arena-tab--active' if active_tab == '2'}" %>
    <%= link_to t("arena.tabs.sacrifice"), arena_room_path(@room, ft: 3), class: "nl-arena-tab #{'nl-arena-tab--active' if active_tab == '3'}" %>
    <%= link_to t("arena.tabs.statistics"), arena_index_path(ft: 4), class: "nl-arena-tab" %>
  </div>

  <div class="nl-arena-application-form" data-arena-target="formContainer">
    <% if @my_application %>
      <div class="nl-arena-current-row">
        <b><%= t("arena.your_application") %>:</b>
        <%= fight_type_label(@my_application.fight_type) %>,
        <%= fight_kind_label(@my_application.fight_kind) %>,
        <%= t("arena.timeout_min", count: @my_application.timeout_seconds / 60) %>,
        <%= t("arena.trauma", percent: @my_application.trauma_percent) %>.
        <%= button_to t("arena.cancel_application"),
            arena_room_arena_application_path(@room, @my_application),
            method: :delete,
            class: "nl-arena-small-button" %>
      </div>
    <% else %>
      <%= form_with url: arena_room_arena_applications_path(@room),
                    method: :post,
                    class: "nl-arena-inline-form",
                    data: { action: "submit->arena#submitApplication" } do |f| %>
        <%= f.hidden_field :fight_type, value: tab_fight_type %>
        <%= f.select :fight_kind,
            [
              [t("arena.form.fight_kind"), ""],
              [t("arena.fight_kinds.no_weapons"), "no_weapons"],
              [t("arena.fight_kinds.free"), "free"],
              [t("arena.fight_kinds.alignment_vs_alignment"), "alignment_vs_alignment"],
              [t("arena.fight_kinds.no_artifacts"), "no_artifacts"],
              [t("arena.fight_kinds.limited_artifacts"), "limited_artifacts"]
            ],
            {},
            class: "nl-arena-select",
            required: true %>
        <%= f.select :turn_seconds,
            [
              [t("arena.form.turn_seconds"), ""],
              [t("arena.form.sec", count: 30), 30],
              [t("arena.form.sec", count: 60), 60],
              [t("arena.form.sec", count: 90), 90]
            ],
            {},
            class: "nl-arena-select",
            required: true %>
        <%= f.hidden_field :timeout_seconds, value: 180 %>
        <%= f.select :wait_minutes,
            [
              [t("arena.form.wait"), ""],
              [t("arena.form.min", count: 2), 2],
              [t("arena.form.min", count: 5), 5],
              [t("arena.form.min", count: 10), 10],
              [t("arena.form.min", count: 15), 15],
              [t("arena.form.min", count: 30), 30]
            ],
            {},
            class: "nl-arena-select",
            required: true %>
        <%= f.select :assault_scroll_kind,
            [
              [t("arena.form.assault_scroll"), ""],
              [t("arena.form.assault_peaceful"), "peaceful"],
              [t("arena.form.assault_normal"), "normal"],
              [t("arena.form.assault_bloody"), "bloody"]
            ],
            {},
            class: "nl-arena-select",
            required: true %>
        <p class="nl-arena-hint"><%= t("arena.form.assault_scroll_hint") %></p>
        <% scroll_qty = Game::World::StartPlayerAssault.trauma_scroll_quantity(current_character) %>
        <% if scroll_qty <= 0 %>
          <p class="nl-quests-board__meta" data-arena-need-scroll="1">
            <%= t("arena.combat_scroll_missing") %>
            ·
            <% if Game::World::CityBuildingCatalog.accessible?(character: current_character, building_key: "hospital") %>
              <%= link_to t("game.buildings.hospital_title_short"),
                    city_building_path("hospital", anchor: "hospital-premium-desk"),
                    class: "nl-sheet-link",
                    data: {arena_recovery: "hospital"} %>
            <% else %>
              <%= link_to t("arena.nav.city"), world_path, class: "nl-sheet-link", data: {turbo: false, arena_recovery: "city"} %>
            <% end %>
            ·
            <%= link_to t("game.inventory.scrolls_block_title"), inventory_path(category: "things", subcategory: "scrolls"), class: "nl-sheet-link" %>
          </p>
        <% end %>

        <% if active_tab != "1" %>
          <span class="nl-arena-team-limits">
            <%= t("arena.form.own_team") %>:
            <%= f.number_field :team_count, min: 1, max: 5, value: 1, class: "nl-arena-mini-input" %>
            <%= t("arena.form.levels_short") %>
            <%= f.number_field :team_level_min, min: 0, max: 33, value: [current_character.level - 1, 0].max, class: "nl-arena-mini-input" %>
            -
            <%= f.number_field :team_level_max, min: 0, max: 33, value: current_character.level + 1, class: "nl-arena-mini-input" %>
            <%= t("arena.form.vs") %>:
            <%= f.number_field :enemy_count, min: 1, max: 5, value: 1, class: "nl-arena-mini-input" %>
            <%= t("arena.form.levels_short") %>
            <%= f.number_field :enemy_level_min, min: 0, max: 33, value: [current_character.level - 1, 0].max, class: "nl-arena-mini-input" %>
            -
            <%= f.number_field :enemy_level_max, min: 0, max: 33, value: current_character.level + 1, class: "nl-arena-mini-input" %>
          </span>
        <% end %>

        <%= f.submit t("arena.form.submit"), class: "nl-arena-small-button" %>
      <% end %>
    <% end %>
  </div>

  <table class="nl-arena-table nl-arena-applications-table arena-applications" data-arena-target="applicationList">
    <thead>
      <tr>
        <th><%= t("arena.table.time") %></th>
        <th><%= t("arena.table.side1") %></th>
        <th><%= t("arena.table.terms") %></th>
        <th><%= t("arena.table.side2") %></th>
        <th><%= t("arena.table.action") %></th>
      </tr>
    </thead>
    <tbody>
      <% if visible_applications.empty? %>
        <tr>
          <td colspan="5" class="nl-arena-empty" data-arena-apps-empty="1">
            <%= t("arena.table.empty") %>
            ·
            <%= t("arena.table.empty_hint") %>
            ·
            <%= link_to t("arena.nav.city"), world_path, class: "nl-sheet-link", data: {turbo: false, arena_recovery: "city"} %>
          </td>
        </tr>
      <% else %>
        <% visible_applications.each do |app| %>
          <% applicant_name = app.npc_application? ? app.npc_template.name : app.applicant.name %>
          <% applicant_level = app.npc_application? ? app.npc_template.level : app.applicant.level %>
          <% own_app = app.applicant == current_character %>
          <tr class="<%= 'nl-arena-row--own' if own_app %> <%= 'nl-arena-row--npc' if app.npc_application? %>" data-application-id="<%= app.id %>">
            <td><%= app.created_at.strftime("%H:%M:%S") %></td>
            <td>
              <b><%= applicant_name %>[<%= applicant_level %>]</b>
              <span class="nl-arena-muted"><%= arena_application_applicant_level_gate(app) %></span>
            </td>
            <td>
              <%= arena_application_rule_label(app) %>,
              <%= t("arena.table.timeout_s", seconds: app.timeout_seconds) %>,
              <%= t("arena.table.trauma_n", percent: app.trauma_percent) %>,
              <%= t("arena.table.wait_for", time: distance_of_time_in_words_to_now(app.expires_at)) %>
            </td>
            <td>
              <b><%= t("arena.table.no_opponents") %></b>
              <span class="nl-arena-muted"><%= arena_application_open_side_level_gate(app) %></span>
            </td>
            <td>
              <% if own_app %>
                <span><%= t("arena.table.your_app") %></span>
                <%= button_to t("arena.table.cancel"),
                    arena_room_arena_application_path(@room, app),
                    method: :delete,
                    class: "nl-arena-small-button" %>
              <% elsif app.acceptable_by?(current_character) %>
                <%= button_to t("arena.table.accept"),
                    accept_arena_room_arena_application_path(@room, app),
                    method: :post,
                    class: "nl-arena-small-button",
                    data: {
                      action: "click->arena#acceptApplication",
                      application_id: app.id
                    } %>
              <% else %>
                <span class="nl-arena-muted"><%= t("arena.table.cannot_accept") %></span>
              <% end %>
            </td>
          </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>

  <% if @active_matches.any? %>
    <div class="nl-arena-active-matches">
      <b><%= t("arena.active_fights") %></b>
      <% @active_matches.each do |match| %>
        <div class="nl-arena-recent-row">
          <%= fight_type_label(match.match_type) %>:
          <%= match.arena_participations.map(&:participant_name).join(" vs ") %>
          <%= link_to t("arena.watch"), arena_match_path(match), class: "nl-arena-filter" %>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="arena-countdown" data-arena-target="countdown" hidden>
    <div class="arena-countdown-title"><%= t("arena.fight_starting") %></div>
    <div class="arena-countdown-timer">--</div>
  </div>
</div>
