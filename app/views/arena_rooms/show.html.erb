<% content_for :title, "#{@room.name} - Arena" %>

<% active_tab = @active_tab %>
<% tab_fight_type = active_tab == "2" ? "team_battle" : "duel" %>
<% visible_applications = @applications %>

<div class="nl-arena-frame"
     data-controller="arena"
     data-arena-room-id-value="<%= @room.id %>"
     data-arena-character-id-value="<%= current_character.id %>"
     data-arena-character-level-value="<%= current_character.level %>"
     data-arena-refresh-url-value="<%= arena_room_path(@room, ft: active_tab, level: @own_level_filter ? nil : "all") %>"
     data-arena-waiting-value="<%= @my_application.present? %>"
     data-arena-expires-at-value="<%= @my_application&.expires_at&.iso8601 %>">
  <div class="nl-arena-feedback" data-arena-target="feedback" role="alert"></div>
  <div class="nl-arena-topline">
    <div class="nl-arena-character">
      <%= current_character.name %>[<%= current_character.level %>]
      <span class="nl-arena-vitals"><%= current_character.current_hp %>/<%= current_character.max_hp %> | <%= current_character.current_mp %>/<%= current_character.max_mp %></span>
    </div>
    <div class="nl-arena-controls">
      <% if @my_application %>
        <% %w[Character Inventory City].each do |label| %><button disabled class="nl-arena-link"><%= label %></button><% end %>
      <% else %>
        <%= link_to "Character", player_path(name: current_character.name), class: "nl-arena-link" %>
        <%= link_to "Inventory", inventory_path, class: "nl-arena-link" %>
        <%= link_to "City", world_path, class: "nl-arena-link", data: {turbo: false} %>
      <% end %>
      <%= link_to "Arena", arena_index_path, class: "nl-arena-link" %>
    </div>
  </div>

  <div class="nl-arena-room-heading">
    <b><%= @room.name %></b>
    <span>levels <%= @room.level_min %>-<%= @room.level_max %></span>
    <% if @room.alignment_restriction.present? %>
      <span><%= @room.alignment_restriction.humanize %></span>
    <% end %>
  </div>

  <div class="nl-arena-status-row">
    <span>Applications: <%= link_to "your level", arena_room_path(@room, ft: active_tab, level: nil), class: "nl-arena-filter" %> | <%= link_to "all", arena_room_path(@room, ft: active_tab, level: "all"), class: "nl-arena-filter" %></span>
    <span>Total: <b><%= visible_applications.size %></b></span>
    <%= link_to "Refresh", arena_room_path(@room, ft: active_tab), class: "nl-arena-link" %>
    <button type="button" class="nl-arena-link nl-arena-link--button" data-action="arena#showRooms" aria-expanded="false">Show building scheme</button>
  </div>

  <%= render "arena/room_scheme", rooms: @rooms, selected_room: @room, active_tab: %>

  <div class="nl-arena-tabs">
    <%= link_to "Duels", arena_room_path(@room, ft: 1), class: "nl-arena-tab #{'nl-arena-tab--active' if active_tab == '1'}" %>
    <%= link_to "Groups", arena_room_path(@room, ft: 2), class: "nl-arena-tab #{'nl-arena-tab--active' if active_tab == '2'}" %>
  </div>

  <div class="nl-arena-application-form" data-arena-target="formContainer">
    <% if @my_application %>
      <div class="nl-arena-current-row"><b>Waiting for the fight to begin!</b></div>
    <% elsif !ArenaApplication.new.character_hp_sufficient?(current_character) %>
      <div class="nl-arena-current-row"><b>Recover before fighting, you are too weakened!</b></div>
    <% else %>
      <%= form_with url: arena_room_arena_applications_path(@room),
                    method: :post,
                    class: "nl-arena-inline-form",
                    data: { action: "input->arena#editing", turbo_frame: "_top" } do |f| %>
        <%= f.hidden_field :fight_type, value: tab_fight_type %>
        <%= f.select :fight_kind,
            [["fight kind", ""]] + arena_fight_kind_options(tab_fight_type),
            {},
            class: "nl-arena-select",
            required: true, aria: {label: "Fight kind"} %>
        <%= f.select :timeout_seconds,
            [["timeout", ""], ["2 min", 120], ["3 min", 180], ["4 min", 240], ["5 min", 300]],
            {},
            class: "nl-arena-select",
            required: true, aria: {label: "Turn timeout"} %>
        <%= f.select :trauma_percent,
            [["trauma", ""], ["low (10%)", 10], ["medium (30%)", 30], ["high (50%)", 50], ["very high (80%)", 80]],
            {},
            class: "nl-arena-select",
            required: true, aria: {label: "Injury probability"} %>

        <% if active_tab != "1" %>
          <%= f.select :wait_minutes,
              [["wait", ""], ["5 min", 5], ["10 min", 10], ["15 min", 15], ["30 min", 30], ["45 min", 45], ["60 min", 60]],
              {},
              class: "nl-arena-select",
              required: true, aria: {label: "Waiting time"} %>
          <span class="nl-arena-team-limits">
            own team:
            <%= f.number_field :team_count, aria: {label: "Your side size"}, required: true, min: 1, max: 30, class: "nl-arena-mini-input" %>
            levels
            <%= f.number_field :team_level_min, aria: {label: "Your side minimum level"}, required: true, min: 0, max: 33, class: "nl-arena-mini-input" %>
            -
            <%= f.number_field :team_level_max, aria: {label: "Your side maximum level"}, required: true, min: 0, max: 33, class: "nl-arena-mini-input" %>
            vs:
            <%= f.number_field :enemy_count, aria: {label: "Opponent side size"}, required: true, min: 1, max: 30, class: "nl-arena-mini-input" %>
            levels
            <%= f.number_field :enemy_level_min, aria: {label: "Opponent side minimum level"}, required: true, min: 0, max: 33, class: "nl-arena-mini-input" %>
            -
            <%= f.number_field :enemy_level_max, aria: {label: "Opponent side maximum level"}, required: true, min: 0, max: 33, class: "nl-arena-mini-input" %>
          </span>
        <% end %>

        <%= f.submit "Submit Application", class: "nl-arena-small-button" %>
      <% end %>
    <% end %>
  </div>

  <div class="nl-arena-applications-table arena-applications" data-arena-target="applicationList">
    <% if visible_applications.empty? %>
      <p class="nl-arena-empty">No open applications</p>
    <% else %>
      <% visible_applications.each do |application| %>
        <%= render "arena_applications/application", application:, character: current_character %>
      <% end %>
    <% end %>
  </div>

  <% if @active_matches.any? %>
    <div class="nl-arena-active-matches">
      <b>Active fights</b>
      <% @active_matches.each do |match| %>
        <div class="nl-arena-recent-row">
          <%= match.match_type.humanize %>:
          <%= match.arena_participations.map(&:participant_name).join(" vs ") %>
          <%= link_to "watch", arena_match_path(match), class: "nl-arena-filter" %>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="arena-countdown" data-arena-target="countdown" hidden>
    <div class="arena-countdown-title">Fight starting</div>
    <div class="arena-countdown-timer">--</div>
  </div>
</div>
